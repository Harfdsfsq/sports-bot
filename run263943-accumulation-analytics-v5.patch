+        norm(row.get('selection') or row.get('selection_key')),
+    ])
+
+
+def _key_point(key_value: str) -> str:
+    parts = str(key_value or '').split('|')
+    return parts[-1] if len(parts) >= 4 else ''
+
+
+def _key_base(key_value: str) -> str:
+    parts = str(key_value or '').split('|')
