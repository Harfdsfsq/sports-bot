# Более жёсткий профиль: меньше ставок, выше шанс убрать спорные heavy-shrink публикации.

PUBLISH_WINDOW_HOURS=12
MAX_PICKS_PER_RUN=1
RUN_REPORT_TOP_REASONS=10

ODDS_MAX=3.60
QUALITY_HIGH_ODDS_MIN_ODDS=3.10
MARKET_DERIVED_MAX_H2H_ODDS=3.50

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

QUALITY_MIN_HISTORY_BETS=120
MIN_QUALITY_SCORE_PUBLISH=60.0
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_EMERGENCY_PUBLISH_ENABLED=false

MARKET_DERIVED_CANDIDATES_ENABLED=false
MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=false

SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true
SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=0.55
SIMPLE_MARKET_TOTALS_MIN_EV_PCT=1.0
SIMPLE_MARKET_TOTALS_MIN_EDGE_PCT=1.3
SIMPLE_MARKET_TOTALS_MIN_CONFIDENCE=52.0
SIMPLE_MARKET_H2H_MIN_EV_PCT=0.9
SIMPLE_MARKET_H2H_MIN_EDGE_PCT=1.3
SIMPLE_MARKET_H2H_MIN_CONFIDENCE=53.0
SIMPLE_MARKET_SPREADS_MIN_EV_PCT=1.0
SIMPLE_MARKET_SPREADS_MIN_EDGE_PCT=1.3
SIMPLE_MARKET_SPREADS_MIN_CONFIDENCE=53.0

ALLOW_LOW_TIER=false

BANKROLL_KELLY_ENABLED=true
BANKROLL_KELLY_FRACTION=0.10
BANKROLL_MIN_STAKE_PCT=0.60
BANKROLL_MAX_STAKE_PCT=2.20
BANKROLL_MAX_OPEN_EXPOSURE_PCT=7.0

CALIBRATION_PROFILE_PATH=.data/calibration-profile.json
CALIBRATION_BLEND_ALPHA_BASE=0.45
CALIBRATION_BLEND_ALPHA_MAX=0.62
CALIBRATION_MAX_GAP_H2H_PP=6.0
CALIBRATION_MAX_GAP_TOTALS_PP=5.5
CALIBRATION_MAX_GAP_SPREADS_PP=6.0
CALIBRATION_MIN_CONFIDENCE_FOR_MAX_GAP=66.0
