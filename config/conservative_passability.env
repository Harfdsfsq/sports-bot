CONTROLLED_FALLBACK_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard,post_calibration_probability_guard

CONTROLLED_FALLBACK_GLOBAL_MIN_ODDS=1.60
CONTROLLED_FALLBACK_GLOBAL_MAX_ODDS=2.75
