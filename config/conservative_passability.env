# Safer profile for regular Run bot.
# Use this when audit shows suspicious candidates or historical ROI is negative.

PUBLISH_DRY_RUN=false
PREDICTION_PUBLICATION_ENABLED=true
RUN_REPORT_ENABLED=true
RUN_REPORT_ONLY_WHEN_NO_PREDICTIONS=false

PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=1

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1
MIN_EDGE_PCT=4.5
MIN_EV_PCT=3.0
TARGET_ODDS_HARD_MIN=1.60
TARGET_ODDS_HARD_MAX=2.35

NO_BET_QUALITY_SCORE_ENABLED=true
MIN_QUALITY_SCORE_PUBLISH=74.0

QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_LAST_RESORT_MIN_CONFIDENCE=999
QUALITY_LAST_RESORT_MIN_EV_PCT=999
QUALITY_LAST_RESORT_MIN_EDGE_PCT=999

REPUBLISH_SEEN_CANDIDATES_WHEN_EMPTY=false
BANKROLL_FORCE_MIN_STAKE_WHEN_EMPTY_ENABLED=false
BANKROLL_KELLY_FRACTION=0.12
BANKROLL_MAX_STAKE_PCT=1.5
BANKROLL_FLAT_STAKE_PCT=1.0
BANKROLL_MAX_OPEN_EXPOSURE_PCT=8.0

MARKET_DERIVED_MIN_BOOKS=2
MARKET_DERIVED_MIN_SOURCES=1
MARKET_DERIVED_MIN_EDGE_PCT=2.2
MARKET_DERIVED_MIN_OBSERVATIONS=2
MARKET_DERIVED_MAX_DISPERSION_PCT=5.0
MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=false

SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=1.00
SIMPLE_MARKET_H2H_HIGH_ODDS_SKIP_MAX=2.50

PIPELINE_INTEGRITY_ENABLED=true
PIPELINE_INTEGRITY_STRICT=true
PIPELINE_INTEGRITY_IMPLIED_TOLERANCE_PP=1.5
PIPELINE_INTEGRITY_ADJUSTED_TOLERANCE_PP=1.5
PIPELINE_INTEGRITY_FAIR_ODDS_RATIO_MAX=1.15
PIPELINE_INTEGRITY_REJECT_ON_NEGATIVE_EDGE_POSITIVE_EV=true
