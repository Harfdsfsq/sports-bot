# Extra variables used by the scripts/workflows in this overlay.

ODDS_SANITY_MAX_IMPLIED_GAP_PP=3.0
ODDS_SANITY_MAX_ODDS_TO_FAIR_RATIO=1.20
ODDS_SANITY_FAIL_ON_PUBLISHED=true

LEARNING_BUNDLE_MAX_RUNS=30
LEARNING_BUNDLE_INCLUDE_EXPORTS=true
LEARNING_BUNDLE_INCLUDE_STATE=true
LEARNING_BUNDLE_INCLUDE_DEBUG=true
LEARNING_BUNDLE_INCLUDE_PROVIDER_CACHE=false
