# Real free-tier API quota governor profile.
# Source: user-provided quotas. Values are operating budgets, not hard provider guarantees.
# Strategy: wide coverage from odds-api.io + bzzoiro, then paid/limited APIs only on shortlist.

PROVIDER_QUOTA_GOVERNOR_ENABLED=true
PROVIDER_QUOTA_RECOVERY_ENABLED=true
PROVIDER_QUOTA_RECOVERY_VERSION=real-quota-v1
PROVIDER_QUOTA_STATE_PATH=.data/provider_quota_governor_state.json

# odds-api.io: 100 requests/hour, account shows 2 bookmakers.
# Use every run. Do not widen bookmakers beyond Bet365,Unibet unless the account changes.
ODDS_API_IO_DAILY_BUDGET=384
ODDS_API_IO_BUCKET_MAX=96
ODDS_API_IO_PER_RUN_MAX=8
ODDS_API_IO_RESERVE_TOKENS=16
ODDS_API_IO_INITIAL_TOKENS=48
ODDS_API_IO_MIN_START_TOKENS=32
ODDS_API_IO_MIN_SPACING_MINUTES=0
ODDS_API_IO_BOOKMAKERS=Bet365,Unibet

# OddsPapi: 250 requests/month ≈ 8/day. Secondary confirmation only.
ODDSPAPI_DAILY_BUDGET=8
ODDSPAPI_BUCKET_MAX=24
ODDSPAPI_PER_RUN_MAX=1
ODDSPAPI_RESERVE_TOKENS=4
ODDSPAPI_INITIAL_TOKENS=10
ODDSPAPI_MIN_START_TOKENS=6
ODDSPAPI_MIN_SPACING_MINUTES=180

# AllSportsAPI: free/trial limit unclear. Keep conservative until dashboard quota is known.
ALLSPORTSAPI_DAILY_BUDGET=12
ALLSPORTSAPI_BUCKET_MAX=32
ALLSPORTSAPI_PER_RUN_MAX=1
ALLSPORTSAPI_RESERVE_TOKENS=4
ALLSPORTSAPI_INITIAL_TOKENS=12
ALLSPORTSAPI_MIN_START_TOKENS=6
ALLSPORTSAPI_MIN_SPACING_MINUTES=120

# SStats: quota not provided; keep medium. Used for form/xG on shortlist.
SSTATS_DAILY_BUDGET=96
SSTATS_BUCKET_MAX=160
SSTATS_PER_RUN_MAX=6
SSTATS_RESERVE_TOKENS=12
SSTATS_INITIAL_TOKENS=36
SSTATS_MIN_START_TOKENS=20
SSTATS_MIN_SPACING_MINUTES=0

# bzzoiro.com: free forever, no rate limits. Use aggressively for prediction context.
BZZOIRO_DAILY_BUDGET=10000
BZZOIRO_BUCKET_MAX=20000
BZZOIRO_PER_RUN_MAX=50
BZZOIRO_RESERVE_TOKENS=0
BZZOIRO_INITIAL_TOKENS=1000
BZZOIRO_MIN_START_TOKENS=100
BZZOIRO_MIN_SPACING_MINUTES=0

# api-football / API-Sports football: 100/day, 10/min. Save ~20/day reserve.
API_FOOTBALL_DAILY_BUDGET=78
API_FOOTBALL_BUCKET_MAX=120
API_FOOTBALL_PER_RUN_MAX=3
API_FOOTBALL_RESERVE_TOKENS=18
API_FOOTBALL_INITIAL_TOKENS=32
API_FOOTBALL_MIN_START_TOKENS=24
API_FOOTBALL_MIN_SPACING_MINUTES=2

# football-data.org registered free: 10/min. Use for standings/history with cache.
FOOTBALL_DATA_DAILY_BUDGET=220
FOOTBALL_DATA_BUCKET_MAX=360
FOOTBALL_DATA_PER_RUN_MAX=8
FOOTBALL_DATA_RESERVE_TOKENS=24
FOOTBALL_DATA_INITIAL_TOKENS=60
FOOTBALL_DATA_MIN_START_TOKENS=32
FOOTBALL_DATA_MIN_SPACING_MINUTES=1

# TheSportsDB: free 30/min. Good broad context with cache.
THESPORTSDB_DAILY_BUDGET=360
THESPORTSDB_BUCKET_MAX=720
THESPORTSDB_PER_RUN_MAX=12
THESPORTSDB_RESERVE_TOKENS=36
THESPORTSDB_INITIAL_TOKENS=96
THESPORTSDB_MIN_START_TOKENS=48
THESPORTSDB_MIN_SPACING_MINUTES=1

# FutrixMetrics: 5000/month ≈ 166/day. Use on shortlist, not whole slate.
FUTRIXMETRICS_DAILY_BUDGET=110
FUTRIXMETRICS_BUCKET_MAX=240
FUTRIXMETRICS_PER_RUN_MAX=5
FUTRIXMETRICS_RESERVE_TOKENS=20
FUTRIXMETRICS_INITIAL_TOKENS=50
FUTRIXMETRICS_MIN_START_TOKENS=28
FUTRIXMETRICS_MIN_SPACING_MINUTES=3

# NewsAPI: 100/day. Only top near-miss / injury-sensitive fixtures.
NEWSAPI_DAILY_BUDGET=34
NEWSAPI_BUCKET_MAX=70
NEWSAPI_PER_RUN_MAX=1
NEWSAPI_RESERVE_TOKENS=12
NEWSAPI_INITIAL_TOKENS=18
NEWSAPI_MIN_START_TOKENS=14
NEWSAPI_MIN_SPACING_MINUTES=30

# GNews: 100/day. Same role as NewsAPI; do not call both for every match.
GNEWS_DAILY_BUDGET=34
GNEWS_BUCKET_MAX=70
GNEWS_PER_RUN_MAX=1
GNEWS_RESERVE_TOKENS=12
GNEWS_INITIAL_TOKENS=18
GNEWS_MIN_START_TOKENS=14
GNEWS_MIN_SPACING_MINUTES=30

# Currents News API: 1000/day, but current repo has no Currents provider. Reserved for future provider.
CURRENTS_NEWS_DAILY_BUDGET=300
CURRENTS_NEWS_BUCKET_MAX=600
CURRENTS_NEWS_PER_RUN_MAX=8
CURRENTS_NEWS_RESERVE_TOKENS=100
CURRENTS_NEWS_ENABLED=false

# WeatherAPI: 100K/month; OpenWeatherMap: 1000/day, 60/min; OpenMeteo free fallback.
# Use for totals/BTTS/weather-sensitive games. Cache strongly.
WEATHER_DAILY_BUDGET=360
WEATHER_BUCKET_MAX=720
WEATHER_PER_RUN_MAX=6
WEATHER_RESERVE_TOKENS=36
WEATHER_INITIAL_TOKENS=96
WEATHER_MIN_START_TOKENS=48
WEATHER_MIN_SPACING_MINUTES=1
WEATHER_CACHE_TTL_MINUTES=240

# Sportsbook API: 50/day. Market anomaly/arbitrage confirmation, not main model input.
RAPIDAPI_SPORTSBOOK_DAILY_BUDGET=18
RAPIDAPI_SPORTSBOOK_BUCKET_MAX=50
RAPIDAPI_SPORTSBOOK_PER_RUN_MAX=1
RAPIDAPI_SPORTSBOOK_RESERVE_TOKENS=6
RAPIDAPI_SPORTSBOOK_INITIAL_TOKENS=12
RAPIDAPI_SPORTSBOOK_MIN_START_TOKENS=8
RAPIDAPI_SPORTSBOOK_MIN_SPACING_MINUTES=60

# OddsFeed: 500/month ≈ 16/day. Late market confirmation only.
RAPIDAPI_ODDS_FEED_DAILY_BUDGET=12
RAPIDAPI_ODDS_FEED_BUCKET_MAX=36
RAPIDAPI_ODDS_FEED_PER_RUN_MAX=1
RAPIDAPI_ODDS_FEED_RESERVE_TOKENS=4
RAPIDAPI_ODDS_FEED_INITIAL_TOKENS=10
RAPIDAPI_ODDS_FEED_MIN_START_TOKENS=6
RAPIDAPI_ODDS_FEED_MIN_SPACING_MINUTES=120

# FreeAPILiveFootballData: 100/month ≈ 3/day. Diagnostics/probe only.
RAPIDAPI_FREE_FOOTBALL_DAILY_BUDGET=3
RAPIDAPI_FREE_FOOTBALL_BUCKET_MAX=10
RAPIDAPI_FREE_FOOTBALL_PER_RUN_MAX=1
RAPIDAPI_FREE_FOOTBALL_RESERVE_TOKENS=2
RAPIDAPI_FREE_FOOTBALL_INITIAL_TOKENS=4
RAPIDAPI_FREE_FOOTBALL_MIN_START_TOKENS=3
RAPIDAPI_FREE_FOOTBALL_MIN_SPACING_MINUTES=360

# SportAPI/API-Sports extra APIs: 100/day each, but current SportAPI7 probe endpoint is not football-useful.
RAPIDAPI_SPORTAPI7_DAILY_BUDGET=0
RAPIDAPI_SPORTAPI7_BUCKET_MAX=1
RAPIDAPI_SPORTAPI7_PER_RUN_MAX=0
RAPIDAPI_SPORTAPI7_INITIAL_TOKENS=0
RAPIDAPI_SPORTAPI7_MIN_START_TOKENS=0

# Meteostat: 500/month ≈ 16/day. Fallback only when WeatherAPI/OpenWeather/OpenMeteo miss.
RAPIDAPI_METEOSTAT_DAILY_BUDGET=10
RAPIDAPI_METEOSTAT_BUCKET_MAX=30
RAPIDAPI_METEOSTAT_PER_RUN_MAX=1
RAPIDAPI_METEOSTAT_RESERVE_TOKENS=4
RAPIDAPI_METEOSTAT_INITIAL_TOKENS=8
RAPIDAPI_METEOSTAT_MIN_START_TOKENS=6
RAPIDAPI_METEOSTAT_MIN_SPACING_MINUTES=120
