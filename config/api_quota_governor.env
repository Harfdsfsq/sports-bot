# Conservative API quota governor profile.
# These are operating budgets, not official provider free-tier limits.
# Increase only after checking exact quotas in each provider dashboard.

PROVIDER_QUOTA_GOVERNOR_ENABLED=true
PROVIDER_QUOTA_RECOVERY_ENABLED=true
PROVIDER_QUOTA_CONTINUOUS_REFILL_ENABLED=true
PROVIDER_QUOTA_RECOVERY_VERSION=continuous-v2
PROVIDER_QUOTA_REFILL_WINDOW_SECONDS=86400
PROVIDER_QUOTA_STATE_PATH=.data/provider_quota_governor_state.json

# Core odds source. Must have reserve + spendable tokens, otherwise it starts at 0 grant.
ODDS_API_IO_DAILY_BUDGET=96
ODDS_API_IO_BUCKET_MAX=160
ODDS_API_IO_PER_RUN_MAX=8
ODDS_API_IO_RESERVE_TOKENS=12
ODDS_API_IO_INITIAL_TOKENS=24
ODDS_API_IO_MIN_START_TOKENS=20

# Secondary odds sources: expensive/noisy, use sparingly.
ODDSPAPI_DAILY_BUDGET=6
ODDSPAPI_BUCKET_MAX=14
ODDSPAPI_PER_RUN_MAX=1
ODDSPAPI_RESERVE_TOKENS=2
ODDSPAPI_INITIAL_TOKENS=4
ODDSPAPI_MIN_START_TOKENS=3

ALLSPORTSAPI_DAILY_BUDGET=6
