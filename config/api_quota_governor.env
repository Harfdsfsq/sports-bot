# Conservative API quota governor profile.
# These are operating budgets, not official provider free-tier limits.
# Increase a value only after checking the exact quota in the provider account dashboard.

PROVIDER_QUOTA_GOVERNOR_ENABLED=true
PROVIDER_QUOTA_STATE_PATH=.data/provider_quota_governor_state.json

# Core odds source: keep enough budget for all-day coverage but avoid full-day burn early.
ODDS_API_IO_DAILY_BUDGET=96
ODDS_API_IO_BUCKET_MAX=160
ODDS_API_IO_PER_RUN_MAX=8
ODDS_API_IO_RESERVE_TOKENS=12

# Secondary odds sources: expensive/noisy, use sparingly.
ODDSPAPI_DAILY_BUDGET=6
ODDSPAPI_BUCKET_MAX=14
ODDSPAPI_PER_RUN_MAX=1
ODDSPAPI_RESERVE_TOKENS=2

ALLSPORTSAPI_DAILY_BUDGET=6
ALLSPORTSAPI_BUCKET_MAX=14
ALLSPORTSAPI_PER_RUN_MAX=1
ALLSPORTSAPI_RESERVE_TOKENS=2

# Context providers.
SSTATS_DAILY_BUDGET=48
SSTATS_BUCKET_MAX=96
SSTATS_PER_RUN_MAX=4
SSTATS_RESERVE_TOKENS=8

BZZOIRO_DAILY_BUDGET=20
BZZOIRO_BUCKET_MAX=48
BZZOIRO_PER_RUN_MAX=2
BZZOIRO_RESERVE_TOKENS=4

API_FOOTBALL_DAILY_BUDGET=24
API_FOOTBALL_BUCKET_MAX=60
API_FOOTBALL_PER_RUN_MAX=3
API_FOOTBALL_RESERVE_TOKENS=5

FOOTBALL_DATA_DAILY_BUDGET=18
FOOTBALL_DATA_BUCKET_MAX=42
FOOTBALL_DATA_PER_RUN_MAX=2
FOOTBALL_DATA_RESERVE_TOKENS=4

THESPORTSDB_DAILY_BUDGET=18
THESPORTSDB_BUCKET_MAX=42
THESPORTSDB_PER_RUN_MAX=2
THESPORTSDB_RESERVE_TOKENS=4

FUTRIXMETRICS_DAILY_BUDGET=4
FUTRIXMETRICS_BUCKET_MAX=10
FUTRIXMETRICS_PER_RUN_MAX=1
FUTRIXMETRICS_RESERVE_TOKENS=1

NEWSAPI_DAILY_BUDGET=8
NEWSAPI_BUCKET_MAX=20
NEWSAPI_PER_RUN_MAX=1
NEWSAPI_RESERVE_TOKENS=2

GNEWS_DAILY_BUDGET=8
GNEWS_BUCKET_MAX=20
GNEWS_PER_RUN_MAX=1
GNEWS_RESERVE_TOKENS=2

WEATHER_DAILY_BUDGET=18
WEATHER_BUCKET_MAX=42
WEATHER_PER_RUN_MAX=2
WEATHER_RESERVE_TOKENS=4

# RapidAPI probes/fallbacks. Keep these very low until endpoint schemas prove useful.
RAPIDAPI_SPORTSBOOK_DAILY_BUDGET=1
RAPIDAPI_SPORTSBOOK_BUCKET_MAX=3
RAPIDAPI_SPORTSBOOK_PER_RUN_MAX=1

RAPIDAPI_ODDS_FEED_DAILY_BUDGET=1
RAPIDAPI_ODDS_FEED_BUCKET_MAX=3
RAPIDAPI_ODDS_FEED_PER_RUN_MAX=1

RAPIDAPI_FREE_FOOTBALL_DAILY_BUDGET=1
RAPIDAPI_FREE_FOOTBALL_BUCKET_MAX=3
RAPIDAPI_FREE_FOOTBALL_PER_RUN_MAX=1

# SportAPI7 sample endpoint is baseball-oriented in the current probe; keep it off by default.
RAPIDAPI_SPORTAPI7_DAILY_BUDGET=0
RAPIDAPI_SPORTAPI7_BUCKET_MAX=1
RAPIDAPI_SPORTAPI7_PER_RUN_MAX=0

RAPIDAPI_METEOSTAT_DAILY_BUDGET=2
RAPIDAPI_METEOSTAT_BUCKET_MAX=6
RAPIDAPI_METEOSTAT_PER_RUN_MAX=1
RAPIDAPI_METEOSTAT_RESERVE_TOKENS=1
