# Final runtime overrides.
# Loaded after balanced_output.env and api_quota_governor.env.

# Telegram localization.
TELEGRAM_FORCE_RUSSIAN=true
TELEGRAM_TRANSLITERATE_UNKNOWN_NAMES=true

# Detailed per-run diagnostics.
DETAILED_RUN_REPORT_ENABLED=true
DETAILED_RUN_REPORT_SEND_TELEGRAM=true
DETAILED_RUN_REPORT_SEND_WHEN_PUBLISHED=false
DETAILED_RUN_REPORT_TOP_NEAR_MISSES=5

# Day inventory must never block the main prediction run.
DAY_INVENTORY_BUILD_TIMEOUT_SECONDS=180
DAY_INVENTORY_BOOTSTRAP_PROVIDER=odds_api_io
DAY_INVENTORY_FORCE_PROVIDER_MERGE=false
DAY_INVENTORY_DIRECT_WINDOW_DAYS=1
DAY_INVENTORY_DIRECT_MIN_MATCHES=4
DAY_INVENTORY_MIN_MATCHES_FOR_SKIP=25
DAY_INVENTORY_MIN_READY_RATIO_PCT=55

# SportLogic runtime enablement.
# Smoke has verified auth/parser/cursor, but current provider inventory is stale.
# Keep the provider alive as a cheap probe until inventory_max_start reaches the active runtime window.
ENABLE_SPORTLOGIC=true
SPORTLOGIC_ENABLED=true
SPORTLOGIC_BASE_URL=https://api.sportlogic.io/api/v1
SPORTLOGIC_HEADER_NAME=X-API-Key
SPORTLOGIC_PER_RUN_MAX=2
SPORTLOGIC_MAX_HTTP_REQUESTS_PER_RUN=2
SPORTLOGIC_REQUEST_BUDGET_GRANTED=2
SPORTLOGIC_REQUEST_BUDGET_REASON=stale_inventory_probe_only
SPORTLOGIC_MATCH_LIMIT=8
SPORTLOGIC_CONTEXT_MATCH_LIMIT=0
SPORTLOGIC_ODDS_MATCH_LIMIT=0
SPORTLOGIC_BOOKMAKERS=__probe_only__
SPORTLOGIC_ODDS_DISABLED_REASON=stale_inventory_probe_only
SPORTLOGIC_TIMEOUT_SECONDS=20
SPORTLOGIC_PROBE_ENABLED=true
SPORTLOGIC_PROBE_MAX_CALLS=2
SPORTLOGIC_PROBE_DAILY_LIMIT=6
SPORTLOGIC_FIXTURE_CURSOR_SCAN_MAX=1
SPORTLOGIC_INVENTORY_LOOKBACK_HOURS=48
SPORTLOGIC_INVENTORY_LOOKAHEAD_DAYS=4

# RapidAPI odds bridge validation result, 2026-05-04:
# - odds_feed sports/events endpoints return 200 and football-like event rows;
# - sportapi7 is monthly-rate-limited (429);
# - sportsbook_api works only as arbitrage/control feed, not normal football fixtures;
# - free_live_football_data is lookup/context-oriented, not verified odds.
# Enable only odds_feed through the secondary bridge slot, with a low per-run budget.
ENABLE_RAPIDAPI_ODDS_BRIDGE=true
RAPIDAPI_ODDS_BRIDGE_ENABLED=true
RAPIDAPI_ODDS_BRIDGE_ALLOWED_PROVIDERS=odds_feed
RAPIDAPI_ODDS_TIMEOUT_SECONDS=8
RAPIDAPI_ODDS_MATCH_LIMIT=24
RAPIDAPI_ODDS_MAX_HTTP_REQUESTS_PER_RUN=3
RAPIDAPI_ODDS_CACHE_TTL_MINUTES=45
ODDS_FEED_RAPIDAPI_HOST=odds-feed.p.rapidapi.com
ODDS_FEED_RAPIDAPI_PER_RUN_MAX=3
SPORTAPI7_RAPIDAPI_ODDS_PER_RUN_MAX=0
SPORTSBOOK_API_RAPIDAPI_PER_RUN_MAX=0
FREE_FOOTBALL_RAPIDAPI_ODDS_PER_RUN_MAX=0
RAPIDAPI_LEGACY_PROBE_TIMEOUT_SECONDS=45

# SharpAPI validation result, 2026-05-04:
# - documented base URL/auth works for /api/v1/quota;
# - /api/v1/odds returns 404 endpoint_not_found;
# - therefore SharpAPI.com is NOT a usable odds source for this bot.
# Keep odds collection disabled. Use SharpAPI only as optional post-selection Telegram text enrichment.
ENABLE_SHARPAPI=false
SHARPAPI_ENABLED=false
SHARPAPI_BASE_URL=https://sharpapi.com
SHARPAPI_API_PREFIX=/api/v1
SHARPAPI_ODDS_ENDPOINTS=/api/v1/odds
SHARPAPI_LEAGUE=Soccer
SHARPAPI_PER_RUN_MAX=0
SHARPAPI_MAX_HTTP_REQUESTS_PER_RUN=0
SHARPAPI_MATCH_LIMIT=0
SHARPAPI_TIMEOUT_SECONDS=6
SHARPAPI_DISABLED_REASON=no_documented_or_available_odds_endpoint
MATCH_TOTAL_OVER15_MAX_REASONABLE_ODDS=1.65

# SharpAPI post-selection Telegram text enrichment.
# This runs only after a pick text is already built and never changes selection, odds, EV, stake or publication decisions.
# If SharpAPI fails or changes important numbers, the original Telegram text is sent unchanged.
SHARPAPI_TEXT_ENRICHMENT_ENABLED=true
SHARPAPI_TEXT_ENDPOINT=/api/v1/content/paraphrase
SHARPAPI_TEXT_LANGUAGE=Russian
SHARPAPI_TEXT_TIMEOUT_SECONDS=10
SHARPAPI_TEXT_POLL_ATTEMPTS=2
SHARPAPI_TEXT_POLL_SLEEP_SECONDS=2
SHARPAPI_TEXT_MAX_RETRY_AFTER_SECONDS=8
SHARPAPI_TEXT_MIN_CHARS=300
SHARPAPI_TEXT_MAX_CHARS=3200
SHARPAPI_TEXT_MAX_LENGTH=3500
SHARPAPI_TEXT_VOICE_TONE=confident, analytical, concise sports betting Telegram style
SHARPAPI_TEXT_CONTEXT=Отредактируй Telegram-прогноз на русском для канала HARIZON. Сохрани все команды, лигу, рынок, коэффициент, сумму, проценты, EV, edge, xG, даты и время без изменений. Не добавляй гарантий, обещаний прибыли или новых фактов. Улучши только стиль, читаемость и связность объяснения.

# Safe proxy totals relief:
# confidence is relaxed slightly, but only with stronger value requirements.
CONTROLLED_FALLBACK_PROXY_SINGLE_SOURCE_MIN_CONFIDENCE=73.5
CONTROLLED_FALLBACK_PROXY_SINGLE_SOURCE_MIN_EDGE_PP=5.0
CONTROLLED_FALLBACK_PROXY_SINGLE_SOURCE_MIN_EV_PCT=10.0

# Keep the same market families. Do not open spreads/h2h/teamtotals/btts here.
CONTROLLED_FALLBACK_ALLOWED_FAMILIES=totals,dnb
CONTROLLED_FALLBACK_TIER_A_ALLOWED_FAMILIES=totals,dnb
CONTROLLED_FALLBACK_TIER_B_ALLOWED_FAMILIES=totals,dnb
CONTROLLED_FALLBACK_TIER_C_ALLOWED_FAMILIES=
CONTROLLED_FALLBACK_TIER_C_PUBLISH_ENABLED=false

# FutrixMetrics shortlist-only mode.
FUTRIXMETRICS_DAILY_BUDGET=60
FUTRIXMETRICS_BUCKET_MAX=160
FUTRIXMETRICS_PER_RUN_MAX=2
FUTRIXMETRICS_RESERVE_TOKENS=20
FUTRIXMETRICS_INITIAL_TOKENS=32
FUTRIXMETRICS_MIN_START_TOKENS=24
FUTRIXMETRICS_MIN_SPACING_MINUTES=15
FUTRIXMETRICS_CONTEXT_MATCH_LIMIT=8

# Daily ops report football-day guard.
DAILY_OPS_FOOTBALL_DAY_GUARD=true
DAILY_OPS_ROLLOVER_HOUR_LOCAL=4
AUTO_LEARNING_ENABLED=true
AUTO_LEARNING_APPLY_RUNTIME_OVERRIDES=true
AUTO_LEARNING_MIN_SETTLED_TOTAL=30
AUTO_LEARNING_MIN_BUCKET_SAMPLES=12
AUTO_LEARNING_ALLOW_THRESHOLD_RELIEF=false
DETAILED_RUN_REPORT_MIN_INTERVAL_MINUTES=20

# Auto-learning feedback loop.
AUTO_LEARNING_ENABLED=true
AUTO_LEARNING_APPLY_RUNTIME_OVERRIDES=true
AUTO_LEARNING_MIN_SETTLED_TOTAL=30
AUTO_LEARNING_MIN_BUCKET_SAMPLES=12
AUTO_LEARNING_ALLOW_THRESHOLD_RELIEF=false

# Avoid duplicate detailed no-pick reports when two runs finish close together.
DETAILED_RUN_REPORT_MIN_INTERVAL_MINUTES=20
DETAILED_RUN_REPORT_TELEGRAM_TOP_NEAR_MISSES=5
AUTO_LEARNING_REPORT_MIN_SAMPLE_TO_SHOW_ROI=10
