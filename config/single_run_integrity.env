# Local/GitHub profile for a single full bot cycle from one run snapshot.
# Copy these values into your .env or into GitHub Actions env.

PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=2

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1
MIN_EDGE_PCT=3.0
MIN_EV_PCT=2.0
MIN_MODEL_CONFIDENCE=0.60
ODDS_MIN=1.70
ODDS_MAX=2.35

QUALITY_LAYER_ENABLED=true
MIN_QUALITY_SCORE_PUBLISH=70.0
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_FALLBACK_MIN_BOOKS_STRICT=2
QUALITY_TOTALS_FALLBACK_ENABLED=true
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=2
QUALITY_TOTALS_FALLBACK_MIN_CONFIDENCE=62.0
QUALITY_TOTALS_FALLBACK_MIN_EV_PCT=2.0
QUALITY_TOTALS_FALLBACK_MIN_EDGE_PCT=3.0
QUALITY_TOTALS_FALLBACK_OVER_MIN_XG_HEADROOM=0.45
QUALITY_TOTALS_FALLBACK_UNDER_MIN_XG_HEADROOM=0.35
QUALITY_HIGH_ODDS_MIN_ODDS=2.35
CORE_SINGLE_BOOK_RELIEF_ENABLED=false

ODDS_SANITY_MAX_IMPLIED_GAP_PP=2.0
ODDS_SANITY_MAX_ODDS_TO_FAIR_RATIO=1.15
ODDS_SANITY_FAIL_ON_PUBLISHED=false

LEARNING_BUNDLE_MAX_RUNS=1
LEARNING_BUNDLE_INCLUDE_DEBUG=true
LEARNING_BUNDLE_INCLUDE_STATE=true
LEARNING_BUNDLE_INCLUDE_EXPORTS=true
