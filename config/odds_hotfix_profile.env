# Apply these values on top of your active profile.
# Goal: stop mixing nearby total lines and catch impossible price/consensus combinations.

SUPPORTED_TOTAL_LINES=1.5,2.0,2.25,2.5,2.75,3.0,3.25,3.5,3.75,4.0,4.25,4.5
LINE_SUPPORT_TOLERANCE=0.02

# Keep core publish tighter while odds mapping is under review
ODDS_MIN=1.72
ODDS_MAX=3.20
MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

# Reduce publication of suspicious totals until mapping bug is resolved
QUALITY_TOTALS_FALLBACK_ENABLED=true
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=2
QUALITY_TOTALS_FALLBACK_MIN_CONFIDENCE=62
QUALITY_TOTALS_FALLBACK_MIN_EV_PCT=2.0
QUALITY_TOTALS_FALLBACK_MIN_EDGE_PCT=3.5
QUALITY_TOTALS_FALLBACK_OVER_MIN_XG_HEADROOM=0.45
QUALITY_TOTALS_FALLBACK_UNDER_MIN_XG_HEADROOM=0.35

# Conservative market-derived totals while line mapping is being stabilized
MARKET_DERIVED_MIN_BOOKS=2
MARKET_DERIVED_MIN_SOURCES=1
MARKET_DERIVED_MIN_OBSERVATIONS=2
MARKET_DERIVED_MIN_EDGE_PCT=1.10
MARKET_DERIVED_MIN_DELTA_PROB_PP=0.00
MARKET_DERIVED_MAX_DISPERSION_PCT=6.0

# Audit thresholds for scripts/audit_odds_sanity.py
ODDS_AUDIT_MAX_PRICE_VS_CONSENSUS_RATIO=1.18
ODDS_AUDIT_MAX_ABS_IMPLIED_GAP_PP=12.0
ODDS_AUDIT_FAIL_ON_TOTALS=true
