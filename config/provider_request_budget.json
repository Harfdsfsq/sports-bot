{
  "version": "v14-api-budget-tighten",
  "description": "Tighter provider request budgets after v13 verification. Goal: preserve coverage from odds-api.io+bzzoiro while preventing autoruns/manual runs from burning monthly providers.",
  "assumptions": {
    "primary_scheduled_runs_per_day": 12,
    "watchdog_normally_skips_pipeline": true,
    "one_governor_token_should_mean_one_external_http_request": true
  },
  "defaults": {
    "enabled": true,
    "reserve_daily_ratio": 0.25,
    "reserve_monthly_ratio": 0.35,
    "manual_runs_do_not_use_expensive_monthly_providers": true
  },
  "providers": {
    "odds_api_io": {
      "enabled": true,
      "limit": {
        "requests_per_hour": 100,
        "bookmakers": 2
      },
      "per_run_max": 8,
      "safe_daily_budget": 240,
      "min_spacing_minutes": 0,
      "notes": "Primary odds source. Keep broad coverage; account allows 2 bookmakers.",
      "env": {
        "ENABLE_ODDS_API_IO": "true",
        "ODDS_API_IO_ENABLED": "true",
        "ODDS_API_IO_PER_RUN_MAX": "8",
        "ODDS_API_IO_BOOKMAKERS": "Bet365,Unibet",
        "ODDS_API_IO_PAGE_LIMIT": "100",
        "ODDS_API_IO_MAX_EVENT_PAGES_PER_SPORT": "10",
        "MAX_MATCHES_FOR_ODDS_FETCH": "70"
      },
      "disable_env": {
        "ENABLE_ODDS_API_IO": "false",
        "ODDS_API_IO_ENABLED": "false",
        "ODDS_API_IO_PER_RUN_MAX": "0",
        "MAX_MATCHES_FOR_ODDS_FETCH": "0"
      }
    },
    "bzzoiro": {
      "enabled": true,
      "limit": {
        "free_forever_no_rate_limit": true
      },
      "per_run_max": 70,
      "safe_daily_budget": 20000,
      "min_spacing_minutes": 0,
      "notes": "Main context expansion source because it has no stated rate limit.",
      "env": {
        "ENABLE_BZZOIRO": "true",
        "ENABLE_BZZOIRO_CONTEXT": "true",
        "BZZOIRO_ENABLED": "true",
        "BZZOIRO_PER_RUN_MAX": "70",
        "BZZOIRO_CONTEXT_MATCH_LIMIT": "80"
      },
      "disable_env": {
        "ENABLE_BZZOIRO": "false",
        "ENABLE_BZZOIRO_CONTEXT": "false",
        "BZZOIRO_ENABLED": "false",
        "BZZOIRO_PER_RUN_MAX": "0",
        "BZZOIRO_CONTEXT_MATCH_LIMIT": "0"
      }
    },
    "api_football": {
      "enabled": false,
      "limit": {
        "requests_per_day": 100,
        "requests_per_minute": 10
      },
      "per_run_max": 0,
      "safe_daily_budget": 0,
      "auth_patterns": [
        "account is suspended",
        "suspended",
        "invalid token",
        "invalid api key"
      ],
      "auth_cooldown_hours": 24,
      "notes": "Disabled because logs show HTTP 200 with body 'Your account is suspended'. Re-enable only after dashboard/API key is fixed.",
      "secret_env_keys": [
        "API_FOOTBALL_KEY"
      ],
      "env": {
        "ENABLE_API_FOOTBALL": "true",
        "API_FOOTBALL_ENABLED": "true",
        "API_FOOTBALL_PER_RUN_MAX": "1",
        "API_FOOTBALL_MAX_HTTP_REQUESTS_PER_RUN": "3",
