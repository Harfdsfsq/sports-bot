# ============================================
# Рекомендуемый overlay для более мягкого, но
# контролируемого отбора кандидатов
# ============================================

# Общий output
ALLOW_LOW_TIER=true
MAX_PICKS_PER_RUN=3
MAX_CANDIDATES_PER_MATCH_PRE_FILTER=4
RUN_REPORT_TOP_REASONS=8

# Базовые вероятностные пороги
MIN_EDGE_PCT=1.6
MIN_EV_PCT=1.1
MIN_MODEL_CONFIDENCE=0.51

# Если в текущем env MIN_BOOKS_PUBLISH выше 1 — вернуть к 1
MIN_BOOKS_PUBLISH=1
MIN_SOURCES_PUBLISH=1

# Simple fallback — мягче, чтобы пустых прогонов было меньше
SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true
SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=0.45
SIMPLE_MARKET_TOTALS_MIN_EV_PCT=0.8
SIMPLE_MARKET_TOTALS_MIN_EDGE_PCT=1.0
SIMPLE_MARKET_TOTALS_MIN_CONFIDENCE=49.0
SIMPLE_MARKET_H2H_MIN_EV_PCT=0.7
SIMPLE_MARKET_H2H_MIN_EDGE_PCT=1.0
SIMPLE_MARKET_H2H_MIN_CONFIDENCE=50.0
SIMPLE_MARKET_SPREADS_MIN_EV_PCT=0.8
SIMPLE_MARKET_SPREADS_MIN_EDGE_PCT=1.1
SIMPLE_MARKET_SPREADS_MIN_CONFIDENCE=50.0

# Market-derived — ослабление самых жёстких мест
MARKET_DERIVED_CANDIDATES_ENABLED=true
MARKET_DERIVED_MIN_BOOKS=1
MARKET_DERIVED_MIN_SOURCES=1
MARKET_DERIVED_MIN_OBSERVATIONS=1
MARKET_DERIVED_MIN_EDGE_PCT=0.8
MARKET_DERIVED_MIN_DELTA_PROB_PP=0.0
MARKET_DERIVED_MAX_DISPERSION_PCT=9.5
MARKET_DERIVED_MAX_H2H_ODDS=4.1
MARKET_DERIVED_CONTEXT_CONFIDENCE_CAP=58.0

MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=true
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_BOOKS=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_SOURCES=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_OBSERVATIONS=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_EDGE_PCT=1.3
MARKET_DERIVED_CONSENSUS_RELIEF_MAX_DISPERSION_PCT=6.5
MARKET_DERIVED_CONSENSUS_RELIEF_PROBABILITY_BOOST_PCT=0.55

# Quality layer — чуть мягче, но не выключен
QUALITY_MIN_HISTORY_BETS=8
MIN_QUALITY_SCORE_PUBLISH=56.0
QUALITY_EMERGENCY_PUBLISH_ENABLED=true
QUALITY_EMERGENCY_MIN_CONFIDENCE=48.0
QUALITY_EMERGENCY_MIN_EV_PCT=0.3
QUALITY_EMERGENCY_MIN_EDGE_PCT=0.5
QUALITY_LAST_RESORT_MIN_CONFIDENCE=45.0
QUALITY_LAST_RESORT_MIN_EV_PCT=0.0
QUALITY_LAST_RESORT_MIN_EDGE_PCT=0.0
HISTORICAL_SEGMENT_RELIEF_ENABLED=true
HISTORICAL_SEGMENT_RELIEF_MIN_CONFIDENCE=56.0
HISTORICAL_SEGMENT_RELIEF_MIN_EV_PCT=0.6
HISTORICAL_SEGMENT_RELIEF_MIN_EDGE_PCT=0.8

# Shadow tracking — обязательно оставить включённым
SHADOW_TRACKING_ENABLED=true
SHADOW_TRACKING_MAX_PER_RUN=10
SHADOW_TRACKING_MIN_PUBLICATION_SCORE=10.0
SHADOW_TRACKING_MIN_EV_PCT=0.4
SHADOW_TRACKING_MIN_EDGE_PCT=0.8
SHADOW_TRACKING_MIN_CONFIDENCE=48.0

# Bankroll — меньше агрессии, пока идёт настройка
BANKROLL_KELLY_ENABLED=true
BANKROLL_KELLY_FRACTION=0.20
BANKROLL_MIN_STAKE_PCT=0.75
BANKROLL_MAX_STAKE_PCT=3.5
BANKROLL_MAX_OPEN_EXPOSURE_PCT=12.0

# Параметры для нового calibration service
CALIBRATION_PROFILE_PATH=.data/calibration-profile.json
CALIBRATION_BLEND_ALPHA_BASE=0.40
CALIBRATION_BLEND_ALPHA_MAX=0.70
CALIBRATION_MAX_GAP_H2H_PP=8.0
CALIBRATION_MAX_GAP_TOTALS_PP=6.5
CALIBRATION_MAX_GAP_SPREADS_PP=7.0
CALIBRATION_MIN_CONFIDENCE_FOR_MAX_GAP=62.0
