APP_ENV=production
PUBLISH_DRY_RUN=true
PREDICTION_PUBLICATION_ENABLED=true
RUN_REPORT_ENABLED=true
DAILY_REPORT_ENABLED=true
NIGHTLY_REVIEW_REPORT_ONLY_ENABLED=false
PUBLISH_WINDOW_HOURS=24
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=1

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1
MIN_EDGE_PCT=2.0
MIN_EV_PCT=1.5
MIN_MODEL_CONFIDENCE=0.53
ODDS_MIN=1.70
ODDS_MAX=2.40

TARGET_BOOKMAKERS=Bet365,Unibet,Pinnacle,Betfair,Bwin
CONSENSUS_BOOKMAKERS=Bet365,Unibet,Pinnacle,Betfair,Bwin

QUALITY_LAYER_ENABLED=true
MIN_QUALITY_SCORE_PUBLISH=70
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false

PHASE12_CANONICALIZE_ENABLED=true
PHASE12_STRICT_MAIN_GATE_ENABLED=true
PHASE12_ALLOW_FAMILIES=totals,dnb,h2h
PHASE12_REJECT_SINGLE_SOURCE=true
PHASE12_ODDS_IMPLIED_MAX_DELTA=0.02
PHASE12_ADJUSTED_MAX_DELTA=0.02
PHASE12_FAIR_ODDS_RATIO_MAX=1.20
