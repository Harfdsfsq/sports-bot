        "SSTATS_ENABLED": "true",
        "SSTATS_TARGET_NEAR_MISS_FIRST": "true",
        "SSTATS_PER_RUN_MAX": "36",
        "SSTATS_REQUESTS_MAX_PER_RUN": "36",
        "SSTATS_MAX_HTTP_REQUESTS_PER_RUN": "36",
        "SSTATS_CONTEXT_MATCH_LIMIT": "72",
        "SSTATS_LOOKBACK_DAYS": "45",
        "SSTATS_RECENT_MATCHES": "10"
      }
    },
    "football_data": {
      "status": "context_only_cached_league_calendar",
      "grant": 6,
      "secret_env_keys": ["FOOTBALL_DATA_API_KEY"],
      "env": {
        "ENABLE_FOOTBALL_DATA_CONTEXT": "true",
        "FOOTBALL_DATA_ENABLED": "true",
        "FOOTBALL_DATA_PER_RUN_MAX": "6",
        "FOOTBALL_DATA_REQUESTS_MAX_PER_RUN": "6",
        "FOOTBALL_DATA_CONTEXT_MATCH_LIMIT": "72",
        "FOOTBALL_DATA_CACHE_TTL_MINUTES": "720"
      }
