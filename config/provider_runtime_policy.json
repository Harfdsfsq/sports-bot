    "thesportsdb": {
      "status": "alias_and_fixture_context_cached",
      "grant": 10,
      "secret_env_keys": ["THESPORTSDB_API_KEY"],
      "env": {
        "ENABLE_THESPORTSDB_CONTEXT": "true",
        "THESPORTSDB_CONTEXT_ENABLED": "true",
        "THESPORTSDB_PER_RUN_MAX": "10",
        "THESPORTSDB_REQUESTS_MAX_PER_RUN": "10",
        "THESPORTSDB_MAX_HTTP_REQUESTS_PER_RUN": "10",
        "THESPORTSDB_CONTEXT_MATCH_LIMIT": "96",
        "THESPORTSDB_CACHE_TTL_MINUTES": "1440"
      }
    },
    "openfootball_public": {
      "status": "public_context_known_dataset_only",
      "grant": 2,
      "env": {
        "ENABLE_OPENFOOTBALL_CONTEXT": "true",
        "OPENFOOTBALL_ENABLED": "true",
        "OPENFOOTBALL_CONTEXT_MATCH_LIMIT": "96",
        "OPENFOOTBALL_MAX_HTTP_REQUESTS_PER_RUN": "2",
        "OPENFOOTBALL_SKIP_404_CACHE_TTL_HOURS": "24"
