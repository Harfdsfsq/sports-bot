{
  "version": "v21-sportlogic-context-probe-odds-quarantined",
  "description": "Single runtime source of truth for provider request grants. SportLogic is enabled only as a low-volume context/matching probe; its odds are quarantined until price payload parsing is fixture-tested.",
  "mode": "per_run_only",
  "deleted_providers": ["api_football"],
  "base_env": {
    "PROVIDER_REQUEST_BUDGET_MODE": "per_run_only",
    "PROVIDER_REQUEST_BUDGET_DISABLE_DAILY_MONTHLY": "true",
    "ALL_SOURCES_FREE_MAXIMIZE": "true",
    "CONTEXT_ENRICHMENT_REQUIRES_OFFERS": "true",
    "CONTEXT_ENRICHMENT_MATCH_LIMIT": "180",
    "PREMIUM_CONTEXT_SHORTLIST_LIMIT": "72",
    "DAY_INVENTORY_NEAR_WINDOW_HOURS": "12",
    "DAY_INVENTORY_NEAR_WINDOW_PRIORITY": "true"
  },
  "deleted_provider_env": {
    "ENABLE_API_FOOTBALL": "false",
    "API_FOOTBALL_ENABLED": "false",
    "API_FOOTBALL_KEY": "",
    "API_FOOTBALL_PER_RUN_MAX": "0",
    "API_FOOTBALL_MAX_HTTP_REQUESTS_PER_RUN": "0",
    "API_FOOTBALL_CONTEXT_MATCH_LIMIT": "0",
    "API_FOOTBALL_PREDICTIONS_LIMIT": "0",
    "API_FOOTBALL_REQUEST_BUDGET_GRANTED": "0",
    "API_FOOTBALL_REQUEST_BUDGET_REASON": "removed_from_project"
  },
  "providers": {
    "odds_api_io": {
      "status": "critical_live_odds",
      "grant": 200,
      "secret_env_keys": ["ODDS_API_IO_KEY"],
      "env": {
        "ENABLE_ODDS_API_IO": "true",
        "ODDS_API_IO_ENABLED": "true",
        "ODDS_API_IO_PER_RUN_MAX": "200",
        "ODDS_API_IO_MAX_HTTP_REQUESTS_PER_RUN": "200",
        "ODDS_API_IO_ACCOUNT1_PER_RUN_MAX": "100",
        "ODDS_API_IO_ACCOUNT2_PER_RUN_MAX": "100",
        "ODDS_API_IO_BOOKMAKERS_ACCOUNT1": "Bet365,Unibet",
        "ODDS_API_IO_BOOKMAKERS_ACCOUNT2": "Betfair Exchange,Sbobet",
        "ODDS_API_IO_PAGE_LIMIT": "100",
        "ODDS_API_IO_MAX_EVENT_PAGES_PER_SPORT": "36",
        "MAX_MATCHES_FOR_ODDS_FETCH": "520"
      }
    },
    "bzzoiro": {
      "status": "high_quality_context",
      "grant": 1000,
      "secret_env_keys": ["BZZOIRO_API_KEY"],
      "env": {
        "ENABLE_BZZOIRO": "true",
        "ENABLE_BZZOIRO_CONTEXT": "true",
        "BZZOIRO_ENABLED": "true",
        "BZZOIRO_PER_RUN_MAX": "1000",
        "BZZOIRO_MAX_HTTP_REQUESTS_PER_RUN": "1000",
        "BZZOIRO_CONTEXT_MATCH_LIMIT": "180",
        "BZZOIRO_MAX_PAGES": "120"
      }
    },
    "sstats": {
      "status": "critical_team_form_context",
      "grant": 150,
      "secret_env_keys": ["SSTATS_API_KEY"],
      "env": {
        "ENABLE_SSTATS": "true",
        "ENABLE_SSTATS_CONTEXT": "true",
        "SSTATS_ENABLED": "true",
        "SSTATS_TARGET_NEAR_MISS_FIRST": "true",
        "SSTATS_PER_RUN_MAX": "150",
        "SSTATS_REQUESTS_MAX_PER_RUN": "150",
        "SSTATS_MAX_HTTP_REQUESTS_PER_RUN": "150",
        "SSTATS_CONTEXT_MATCH_LIMIT": "180",
        "SSTATS_LOOKBACK_DAYS": "45",
        "SSTATS_RECENT_MATCHES": "10"
      }
    },
    "football_data": {
      "status": "context_only_low_overlap",
      "grant": 8,
      "secret_env_keys": ["FOOTBALL_DATA_API_KEY"],
      "env": {
        "ENABLE_FOOTBALL_DATA_CONTEXT": "true",
        "FOOTBALL_DATA_ENABLED": "true",
        "FOOTBALL_DATA_PER_RUN_MAX": "8",
        "FOOTBALL_DATA_REQUESTS_MAX_PER_RUN": "8",
        "FOOTBALL_DATA_CONTEXT_MATCH_LIMIT": "48"
      }
    },
    "thesportsdb": {
      "status": "context_only_alias_sensitive",
      "grant": 12,
      "secret_env_keys": ["THESPORTSDB_API_KEY"],
      "env": {
        "ENABLE_THESPORTSDB_CONTEXT": "true",
        "THESPORTSDB_CONTEXT_ENABLED": "true",
        "THESPORTSDB_PER_RUN_MAX": "12",
        "THESPORTSDB_REQUESTS_MAX_PER_RUN": "12",
        "THESPORTSDB_MAX_HTTP_REQUESTS_PER_RUN": "12",
        "THESPORTSDB_CONTEXT_MATCH_LIMIT": "60"
      }
    },
    "openfootball_public": {
      "status": "public_context_known_dataset_only",
      "grant": 4,
      "env": {
        "ENABLE_OPENFOOTBALL_CONTEXT": "true",
        "OPENFOOTBALL_ENABLED": "true",
        "OPENFOOTBALL_CONTEXT_MATCH_LIMIT": "80",
        "OPENFOOTBALL_MAX_HTTP_REQUESTS_PER_RUN": "4",
        "OPENFOOTBALL_SKIP_404_CACHE_TTL_HOURS": "24"
      }
    },
    "weatherapi": {
      "status": "weather_overlay",
      "grant": 12,
      "secret_env_keys": ["WEATHERAPI_KEY", "WEATHER_API_KEY", "WEATHERAPI_API_KEY"],
      "env": {
        "ENABLE_WEATHERAPI": "true",
        "WEATHERAPI_ENABLED": "true",
        "WEATHERAPI_PER_RUN_MAX": "12",
        "WEATHERAPI_MAX_HTTP_REQUESTS_PER_RUN": "12",
        "WEATHER_CONTEXT_ENABLED": "true",
        "WEATHER_CONTEXT_MATCH_LIMIT": "24",
        "WEATHER_CACHE_TTL_MINUTES": "240"
      }
    },
    "openweathermap": {
      "status": "weather_fallback",
      "grant": 8,
      "secret_env_keys": ["OPENWEATHERMAP_API_KEY", "OPENWEATHER_API_KEY", "OPENWEATHERMAP_KEY"],
      "env": {
        "ENABLE_OPENWEATHERMAP": "true",
        "OPENWEATHERMAP_ENABLED": "true",
        "OPENWEATHERMAP_PER_RUN_MAX": "8",
        "OPENWEATHERMAP_MAX_HTTP_REQUESTS_PER_RUN": "8",
        "WEATHER_OPENWEATHERMAP_FALLBACK_ENABLED": "true"
      }
    },
    "sportlogic": {
      "status": "context_probe_odds_quarantined",
      "grant": 20,
      "reason": "enabled_for_context_matching_probe:odds_quarantined_until_parser_verified",
      "secret_env_keys": ["SPORTLOGIC_API_KEY", "SPORTLOGIC_KEY", "SPORTLOGIC_TOKEN"],
      "env": {
        "ENABLE_SPORTLOGIC": "true",
        "SPORTLOGIC_ENABLED": "true",
        "SPORTLOGIC_PER_RUN_MAX": "20",
        "SPORTLOGIC_MAX_HTTP_REQUESTS_PER_RUN": "20",
        "SPORTLOGIC_MATCH_LIMIT": "60",
        "SPORTLOGIC_CONTEXT_MATCH_LIMIT": "60",
        "SPORTLOGIC_ODDS_MATCH_LIMIT": "1",
        "SPORTLOGIC_BOOKMAKERS": "__probe_only__",
        "SPORTLOGIC_ODDS_DISABLED_REASON": "odds_quarantined_context_probe_only"
      }
    },
    "oddspapi": {
      "status": "rate_limited",
      "grant": 0,
      "reason": "cooldown_active:fatal_pattern:REQUEST_LIMIT_EXCEEDED",
      "env": {
        "ODDSPAPI_PER_RUN_MAX": "0",
        "ODDSPAPI_CONTEXT_MATCH_LIMIT": "0",
        "ODDSPAPI_MATCH_LIMIT": "0"
      }
    },
    "futrixmetrics": {
      "status": "spacing_limited_low_yield",
      "grant": 0,
      "reason": "disabled_by_useful_request_policy:low_recent_yield",
      "env": {
        "FUTRIXMETRICS_PER_RUN_MAX": "0",
        "FUTRIXMETRICS_REQUESTS_MAX_PER_RUN": "0",
        "FUTRIXMETRICS_CONTEXT_MATCH_LIMIT": "0"
      }
    },
    "newsapi_currents": {
      "status": "news_context_rotation",
      "grant": 0,
      "reason": "disabled_by_useful_request_policy:news_context_not_every_run",
      "env": {
        "NEWSAPI_PER_RUN_MAX": "0",
        "NEWSAPI_MAX_HTTP_REQUESTS_PER_RUN": "0",
        "NEWSAPI_MATCH_LIMIT": "0",
        "CURRENTS_NEWS_PER_RUN_MAX": "0",
        "CURRENTS_NEWS_MAX_HTTP_REQUESTS_PER_RUN": "0"
      }
    },
    "gnews": {
      "status": "news_context_rotation",
      "grant": 0,
      "reason": "disabled_by_useful_request_policy:news_context_not_every_run",
      "env": {
        "GNEWS_PER_RUN_MAX": "0",
        "GNEWS_MAX_HTTP_REQUESTS_PER_RUN": "0",
        "GNEWS_CONTEXT_MATCH_LIMIT": "0",
        "GNEWS_MATCH_LIMIT": "0"
      }
    },
    "meteostat": {
      "status": "weather_rotation",
      "grant": 0,
      "reason": "disabled_by_useful_request_policy:weatherapi_first",
      "env": {
        "RAPIDAPI_METEOSTAT_PER_RUN_MAX": "0",
        "METEOSTAT_MAX_HTTP_REQUESTS_PER_RUN": "0"
      }
    },
    "oddsfeed": {
      "status": "discovery_only",
      "grant": 0,
      "reason": "disabled_until_endpoint_schema_verified",
      "env": {
        "RAPIDAPI_ODDS_FEED_PER_RUN_MAX": "0",
        "RAPIDAPI_DISCOVERY_ODDS_FEED_MAX_CALLS": "0"
      }
    },
    "sportsbook_api": {
      "status": "discovery_only",
      "grant": 0,
      "reason": "disabled_until_endpoint_schema_verified",
      "env": {
        "RAPIDAPI_SPORTSBOOK_PER_RUN_MAX": "0",
        "RAPIDAPI_DISCOVERY_SPORTSBOOK_MAX_CALLS": "0"
      }
    },
    "sportapi": {
      "status": "discovery_only",
      "grant": 0,
      "reason": "disabled_until_endpoint_schema_verified",
      "env": {
        "RAPIDAPI_SPORTAPI7_PER_RUN_MAX": "0",
        "RAPIDAPI_DISCOVERY_SPORTAPI7_MAX_CALLS": "0"
      }
    },
    "freeapilivefootball": {
      "status": "discovery_only",
      "grant": 0,
      "reason": "disabled_until_endpoint_schema_verified",
      "env": {
        "RAPIDAPI_FREE_FOOTBALL_PER_RUN_MAX": "0",
        "RAPIDAPI_DISCOVERY_FREE_FOOTBALL_MAX_CALLS": "0"
      }
    }
  }
}
