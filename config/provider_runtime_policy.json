{
  "version": "v24-free-limit-balanced-odds-rescue",
  "description": "Free-limit aware request grants: odds-api.io as inventory/primary odds, SStats/Bzzoiro as near-window context, and controlled secondary odds rescue via AllSportsAPI, SportLogic and OddsPapi only when primary odds are empty or thin.",
  "mode": "per_run_with_daily_guards",
  "deleted_providers": ["api_football", "bookies_api"],
  "base_env": {
    "PROVIDER_REQUEST_BUDGET_MODE": "per_run_with_daily_guards",
    "PROVIDER_REQUEST_BUDGET_DISABLE_DAILY_MONTHLY": "false",
    "PROVIDER_QUOTA_RUNS_PER_DAY": "12",
    "PROVIDER_QUOTA_SAFETY_FACTOR": "0.72",
    "ALL_SOURCES_FREE_MAXIMIZE": "true",
    "CONTEXT_ENRICHMENT_REQUIRES_OFFERS": "true",
    "CONTEXT_ENRICHMENT_MATCH_LIMIT": "240",
    "PREMIUM_CONTEXT_SHORTLIST_LIMIT": "96",
    "DAY_INVENTORY_NEAR_WINDOW_HOURS": "12",
    "DAY_INVENTORY_NEAR_WINDOW_PRIORITY": "true",
    "NEAR_WINDOW_CONTEXT_PRIORITY_ENABLED": "true",
    "NEAR_WINDOW_CONTEXT_HOURS": "12",
    "NEAR_WINDOW_CONTEXT_MIN_MATCHES": "48",
    "NEAR_WINDOW_PROVIDER_CONTEXT_MIN_MATCHES": "36",
    "NEAR_WINDOW_PRIORITY_MIN_LEAD_MINUTES": "25",
    "API_HEALTH_DURING_RUN_ENABLED": "true",
    "API_HEALTH_MODE": "quick",
    "API_HEALTH_GUARD_TIMEOUT_SECONDS": "45",
    "FIXTURE_EXPANSION_ENABLED": "true",
    "SECONDARY_ODDS_RESCUE_ENABLED": "true",
    "SECONDARY_ODDS_RESCUE_TRIGGER": "odds_api_io_empty_or_thin",
    "SECONDARY_ODDS_RESCUE_MIN_PRIMARY_OFFERS": "20",
    "SECONDARY_ODDS_RESCUE_NEAR_WINDOW_HOURS": "12"
  },
  "deleted_provider_env": {
    "ENABLE_API_FOOTBALL": "false",
    "API_FOOTBALL_ENABLED": "false",
    "API_FOOTBALL_KEY": "",
    "API_FOOTBALL_PER_RUN_MAX": "0",
    "API_FOOTBALL_MAX_HTTP_REQUESTS_PER_RUN": "0",
    "API_FOOTBALL_CONTEXT_MATCH_LIMIT": "0",
    "API_FOOTBALL_PREDICTIONS_LIMIT": "0",
    "API_FOOTBALL_REQUEST_BUDGET_GRANTED": "0",
    "API_FOOTBALL_REQUEST_BUDGET_REASON": "removed_from_project",
    "ENABLE_BOOKIES_API": "false",
    "BOOKIES_API_ENABLED": "false",
    "BOOKIES_API_ODDS_FETCH_LIMIT": "0",
    "BOOKIES_API_REQUEST_BUDGET_GRANTED": "0",
    "BOOKIES_API_REQUEST_BUDGET_REASON": "removed_from_project"
  },
  "providers": {
    "odds_api_io": {
      "status": "critical_inventory_and_primary_live_odds",
      "grant": 120,
      "secret_env_keys": ["ODDS_API_IO_KEY", "ODDS_API_IO_KEY_2"],
      "free_limit_note": "Conservative planning: 100 requests/hour per account while dashboard is unverified.",
      "env": {
        "ENABLE_ODDS_API_IO": "true",
        "ODDS_API_IO_ENABLED": "true",
        "ODDS_API_IO_PER_RUN_MAX": "120",
        "ODDS_API_IO_MAX_HTTP_REQUESTS_PER_RUN": "120",
        "ODDS_API_IO_ACCOUNT1_PER_RUN_MAX": "60",
        "ODDS_API_IO_ACCOUNT2_PER_RUN_MAX": "60",
        "ODDS_API_IO_BOOKMAKERS_ACCOUNT1": "Bet365,Unibet",
        "ODDS_API_IO_BOOKMAKERS_ACCOUNT2": "William Hill,Bwin",
        "ODDS_API_IO_PAGE_LIMIT": "100",
        "ODDS_API_IO_MAX_EVENT_PAGES_PER_SPORT": "18",
        "ODDS_API_IO_BOOKMAKER_ALIAS_EMPTY_RETRY_ENABLED": "false",
        "ODDS_API_IO_UNFILTERED_EMPTY_RETRY_ENABLED": "false",
        "MAX_MATCHES_FOR_ODDS_FETCH": "420"
      }
    },
    "allsportsapi": {
      "status": "secondary_fixture_and_odds_rescue",
      "grant": 24,
      "secret_env_keys": ["ALLSPORTSAPI_API_KEY"],
      "env": {
        "ENABLE_ALLSPORTSAPI": "true",
        "ALLSPORTSAPI_ENABLED": "true",
        "ALLSPORTSAPI_PER_RUN_MAX": "24",
        "ALLSPORTSAPI_MAX_HTTP_REQUESTS_PER_RUN": "24",
        "ALLSPORTSAPI_MATCH_LIMIT": "48",
        "ALLSPORTSAPI_REQUESTS_MAX_PER_RUN": "24",
        "ALLSPORTSAPI_ONLY_IF_PRIMARY_ODDS_EMPTY": "true"
      }
    },
    "sportlogic": {
      "status": "secondary_odds_rescue_and_context_probe",
      "grant": 30,
      "reason": "free_limit_500_day_10_min_use_only_near_window_or_primary_odds_empty",
      "secret_env_keys": ["SPORTLOGIC_API_KEY", "SPORTLOGIC_KEY", "SPORTLOGIC_TOKEN"],
      "env": {
        "ENABLE_SPORTLOGIC": "true",
        "SPORTLOGIC_ENABLED": "true",
        "SPORTLOGIC_CONTROLLED_ODDS_ENABLED": "true",
        "SPORTLOGIC_PER_RUN_MAX": "30",
        "SPORTLOGIC_MAX_HTTP_REQUESTS_PER_RUN": "30",
        "SPORTLOGIC_MATCH_LIMIT": "60",
        "SPORTLOGIC_CONTEXT_MATCH_LIMIT": "60",
        "SPORTLOGIC_ODDS_MATCH_LIMIT": "24",
        "SPORTLOGIC_PER_PAGE": "50",
        "SPORTLOGIC_MIN_SECONDS_BETWEEN_REQUESTS": "7",
        "SPORTLOGIC_ONLY_IF_PRIMARY_ODDS_EMPTY": "true"
      }
    },
    "oddspapi": {
      "status": "last_resort_odds_rescue_monthly_limited",
      "grant": 2,
      "secret_env_keys": ["ODDSPAPI_API_KEY", "ODDSPAPI_KEY", "ODDS_PAPI_API_KEY"],
      "env": {
        "ENABLE_ODDSPAPI": "true",
        "ODDSPAPI_ENABLED": "true",
        "ODDSPAPI_PER_RUN_MAX": "2",
        "ODDSPAPI_MAX_HTTP_REQUESTS_PER_RUN": "2",
        "ODDSPAPI_MATCH_LIMIT": "16",
        "ODDSPAPI_CONTEXT_MATCH_LIMIT": "0",
        "ODDSPAPI_ONLY_IF_PRIMARY_ODDS_EMPTY": "true"
      }
    },
    "bzzoiro": {
      "status": "high_quality_context_near_window_first",
      "grant": 24,
      "secret_env_keys": ["BZZOIRO_API_KEY"],
      "env": {
        "ENABLE_BZZOIRO": "true",
        "ENABLE_BZZOIRO_CONTEXT": "true",
        "BZZOIRO_ENABLED": "true",
        "BZZOIRO_PER_RUN_MAX": "24",
        "BZZOIRO_MAX_HTTP_REQUESTS_PER_RUN": "24",
        "BZZOIRO_CONTEXT_MATCH_LIMIT": "72",
        "BZZOIRO_MAX_PAGES": "6",
        "BZZOIRO_PAGE_SIZE": "10",
        "BZZOIRO_TARGET_NEAR_WINDOW_FIRST": "true"
      }
    },
    "sstats": {
      "status": "critical_team_form_context_near_window_first",
      "grant": 36,
      "secret_env_keys": ["SSTATS_API_KEY"],
      "env": {
        "ENABLE_SSTATS": "true",
