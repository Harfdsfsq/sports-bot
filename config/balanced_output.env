RAPIDAPI_DISCOVERY_SPORTSBOOK_MAX_CALLS=4
RAPIDAPI_DISCOVERY_ODDS_FEED_MAX_CALLS=3


# RapidAPI endpoint discovery:
# Diagnostics-only. Probes likely football endpoints with strict daily call budgets.
# Does not use discovered data in betting decisions until endpoint schemas are confirmed.
