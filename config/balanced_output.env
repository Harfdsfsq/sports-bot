# Лог-ориентированный hotfix после прогона 23.04.2026
# Цель: сохранить количество ставок, но убрать часть мусорных high-odds и
# временно ослабить переобученный historical guard.

PUBLISH_WINDOW_HOURS=12
MAX_PICKS_PER_RUN=2
RUN_REPORT_TOP_REASONS=10

# Убираем часть рискованных дальних выстрелов
ODDS_MAX=3.90
QUALITY_HIGH_ODDS_MIN_ODDS=3.25
MARKET_DERIVED_MAX_H2H_ODDS=3.70

# Главная пробка в логе — publish books guard
MIN_BOOKS_PUBLISH=1
MIN_SOURCES_PUBLISH=1

# Не даём history-слою переучиваться на 72 settled ставках
QUALITY_MIN_HISTORY_BETS=100
MIN_QUALITY_SCORE_PUBLISH=58.0
HISTORICAL_SEGMENT_RELIEF_ENABLED=true
HISTORICAL_SEGMENT_RELIEF_MIN_CONFIDENCE=55.0
HISTORICAL_SEGMENT_RELIEF_MIN_EV_PCT=0.5
HISTORICAL_SEGMENT_RELIEF_MIN_EDGE_PCT=0.8

# Временно отключаем market-derived до накопления истории,
# потому что в логе он даёт шумные отказы и 0 опубликованных сигналов
MARKET_DERIVED_CANDIDATES_ENABLED=false
MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=false

# Делаем fallback чуть мягче, чтобы не было пустых прогонов
SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true
SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=0.45
SIMPLE_MARKET_TOTALS_MIN_EV_PCT=0.9
SIMPLE_MARKET_TOTALS_MIN_EDGE_PCT=1.1
SIMPLE_MARKET_TOTALS_MIN_CONFIDENCE=50.0
SIMPLE_MARKET_H2H_MIN_EV_PCT=0.8
SIMPLE_MARKET_H2H_MIN_EDGE_PCT=1.1
SIMPLE_MARKET_H2H_MIN_CONFIDENCE=51.0
SIMPLE_MARKET_SPREADS_MIN_EV_PCT=0.9
SIMPLE_MARKET_SPREADS_MIN_EDGE_PCT=1.2
SIMPLE_MARKET_SPREADS_MIN_CONFIDENCE=51.0

# Низшие/экзотические лиги пока режем, потому что historical log показывает
# заметную просадку по non-core рынкам
ALLOW_LOW_TIER=false

# Банкролл делаем мягче: опубликованный pick был на 4.10 и 3.66% банка — это многовато
BANKROLL_KELLY_ENABLED=true
BANKROLL_KELLY_FRACTION=0.15
BANKROLL_MIN_STAKE_PCT=0.75
BANKROLL_MAX_STAKE_PCT=2.75
BANKROLL_MAX_OPEN_EXPOSURE_PCT=9.0

# Подготовка к новой калибровке
CALIBRATION_PROFILE_PATH=.data/calibration-profile.json
CALIBRATION_BLEND_ALPHA_BASE=0.42
CALIBRATION_BLEND_ALPHA_MAX=0.68
CALIBRATION_MAX_GAP_H2H_PP=7.0
CALIBRATION_MAX_GAP_TOTALS_PP=6.0
CALIBRATION_MAX_GAP_SPREADS_PP=6.5
CALIBRATION_MIN_CONFIDENCE_FOR_MAX_GAP=64.0
