# Balanced profile: increase candidate supply safely, then publish only through strict tiered fallback if main quality returns 0.
PUBLISH_WINDOW_HOURS=24
MIN_KICKOFF_LEAD_MINUTES=20
MAX_PICKS_PER_RUN=1
MAX_INTERNAL_CANDIDATES_PER_RUN=16
MAX_CANDIDATES_PER_MATCH_PRE_FILTER=4

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1
ODDS_MIN=1.55
ODDS_MAX=3.05
TARGET_ODDS_HARD_MIN=1.55
TARGET_ODDS_HARD_MAX=3.05

BANKROLL_KELLY_ENABLED=false
BANKROLL_FLAT_STAKE_PCT=0.65
BANKROLL_MIN_STAKE_AMOUNT=5
BANKROLL_MAX_STAKE_PCT=1.0
BANKROLL_MAX_OPEN_EXPOSURE_PCT=16

# Keep internal quality rescue disabled. Only external controlled fallback may publish reserve picks.
QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_LAST_RESORT_MIN_BOOKS=99
QUALITY_LAST_RESORT_MIN_CONFIDENCE=99
QUALITY_LAST_RESORT_MIN_EV_PCT=999
QUALITY_LAST_RESORT_MIN_EDGE_PCT=999
QUALITY_FALLBACK_MIN_BOOKS_STRICT=99
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=99
MIN_QUALITY_SCORE_PUBLISH=62
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_HIGH_ODDS_MIN_ODDS=2.85

# Candidate supply: re-enable market-derived candidates, but keep the derived signal requirements tighter.
MARKET_DERIVED_CANDIDATES_ENABLED=true
MARKET_DERIVED_MIN_BOOKS=2
MARKET_DERIVED_MIN_SOURCES=1
MARKET_DERIVED_MIN_OBSERVATIONS=1
MARKET_DERIVED_MIN_EDGE_PCT=2.4
MARKET_DERIVED_MIN_DELTA_PROB_PP=0.0
MARKET_DERIVED_MAX_DISPERSION_PCT=5.0
MARKET_DERIVED_MAX_H2H_ODDS=2.65
MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=true
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_BOOKS=2
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_SOURCES=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_EDGE_PCT=3.0
MARKET_DERIVED_CONSENSUS_RELIEF_MAX_DISPERSION_PCT=4.2
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_OBSERVATIONS=1

SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true
SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=0.5
SIMPLE_MARKET_TOTALS_MIN_EV_PCT=0.8
SIMPLE_MARKET_TOTALS_MIN_EDGE_PCT=1.1
SIMPLE_MARKET_TOTALS_MIN_CONFIDENCE=50
SIMPLE_MARKET_SPREADS_MIN_EV_PCT=1.2
SIMPLE_MARKET_SPREADS_MIN_EDGE_PCT=1.6
SIMPLE_MARKET_SPREADS_MIN_CONFIDENCE=54
SIMPLE_MARKET_H2H_MIN_EV_PCT=1.4
SIMPLE_MARKET_H2H_MIN_EDGE_PCT=1.8
SIMPLE_MARKET_H2H_MIN_CONFIDENCE=56

# External controlled fallback settings.
CONTROLLED_FALLBACK_ENABLED=true
CONTROLLED_FALLBACK_SEND_TELEGRAM=true
CONTROLLED_FALLBACK_SEND_NO_PICK_REPORT=true
CONTROLLED_FALLBACK_DEDUPE_HOURS=72

CONTROLLED_FALLBACK_ALLOWED_FAMILIES=totals,dnb,teamtotals,teamTotals,btts
CONTROLLED_FALLBACK_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard,post_calibration_probability_guard,post_calibration_edge_guard

CONTROLLED_FALLBACK_GLOBAL_MIN_ODDS=1.55
CONTROLLED_FALLBACK_GLOBAL_MAX_ODDS=3.05

CONTROLLED_FALLBACK_TIER_A_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_A_MIN_CONFIDENCE=62
CONTROLLED_FALLBACK_TIER_A_MIN_QUALITY=66
CONTROLLED_FALLBACK_TIER_A_MIN_EDGE_PP=2.5
CONTROLLED_FALLBACK_TIER_A_MIN_EV_PCT=4.0
CONTROLLED_FALLBACK_TIER_A_MIN_PUBLICATION_SCORE=24

CONTROLLED_FALLBACK_TIER_B_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_B_MIN_CONFIDENCE=60
CONTROLLED_FALLBACK_TIER_B_MIN_QUALITY=58
CONTROLLED_FALLBACK_TIER_B_MIN_EDGE_PP=1.7
CONTROLLED_FALLBACK_TIER_B_MIN_EV_PCT=2.8
CONTROLLED_FALLBACK_TIER_B_MIN_PUBLICATION_SCORE=18

CONTROLLED_FALLBACK_TIER_C_ALLOWED_FAMILIES=totals,teamtotals,teamTotals,dnb
CONTROLLED_FALLBACK_TIER_C_MIN_BOOKS=1
CONTROLLED_FALLBACK_TIER_C_MIN_CONFIDENCE=58
CONTROLLED_FALLBACK_TIER_C_MIN_QUALITY=50
CONTROLLED_FALLBACK_TIER_C_MIN_EDGE_PP=1.6
CONTROLLED_FALLBACK_TIER_C_MIN_EV_PCT=4.0
CONTROLLED_FALLBACK_TIER_C_MIN_PUBLICATION_SCORE=16
CONTROLLED_FALLBACK_TIER_C_MAX_ODDS=2.85
CONTROLLED_FALLBACK_TIER_C_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard

CONTROLLED_FALLBACK_STAKE_PCT=0.65
CONTROLLED_FALLBACK_MIN_STAKE=5
CONTROLLED_FALLBACK_MAX_STAKE_TIER_A=8
CONTROLLED_FALLBACK_MAX_STAKE_TIER_B=6
CONTROLLED_FALLBACK_MAX_STAKE_TIER_C=5
