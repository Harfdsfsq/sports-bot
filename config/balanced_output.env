# Balanced profile: external Telegram publisher + widened candidate supply.
# Goal: let the app produce enough pre-quality candidates, then allow the controlled fallback gate
# to make the final safe decision from canonical EV/edge. The app itself does not publish Telegram.

PUBLISH_WINDOW_HOURS=24
MIN_KICKOFF_LEAD_MINUTES=20
MAX_PICKS_PER_RUN=1
MIN_BOOKS_PUBLISH=1
MIN_SOURCES_PUBLISH=1
MAX_INTERNAL_CANDIDATES_PER_RUN=40
MAX_CANDIDATES_PER_MATCH_PRE_FILTER=8

ODDS_MIN=1.45
ODDS_MAX=3.10
TARGET_ODDS_HARD_MIN=1.45
TARGET_ODDS_HARD_MAX=3.10

BANKROLL_KELLY_ENABLED=false
BANKROLL_FLAT_STAKE_PCT=0.65
BANKROLL_MIN_STAKE_AMOUNT=5
BANKROLL_MAX_STAKE_PCT=1.0
BANKROLL_MAX_OPEN_EXPOSURE_PCT=16

# Main app must not publish directly. Telegram is handled only by scripts/publish_controlled_fallback.py.
PREDICTION_PUBLICATION_ENABLED=false
RUN_REPORT_ENABLED=false
RUN_REPORT_ONLY_WHEN_NO_PREDICTIONS=true

# Disable internal rescue modes so weak app-level last-resort picks never appear as "best bet".
QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_LAST_RESORT_MIN_BOOKS=99
QUALITY_LAST_RESORT_MIN_CONFIDENCE=99
QUALITY_LAST_RESORT_MIN_EV_PCT=999
QUALITY_LAST_RESORT_MIN_EDGE_PCT=999
QUALITY_FALLBACK_MIN_BOOKS_STRICT=99
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=99
MIN_QUALITY_SCORE_PUBLISH=62
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_HIGH_ODDS_MIN_ODDS=2.85

# Candidate supply widening: these thresholds are intentionally looser because final publish
# still requires positive canonical EV/edge in controlled fallback.
MIN_EDGE_PCT=-1.5
MIN_EV_PCT=-4.0
MIN_MODEL_CONFIDENCE=0.48
PROBABILITY_GATE_RELIEF_MAX_GAP=0.12
PROBABILITY_GATE_RELIEF_MIN_CONFIDENCE=48
PROBABILITY_GATE_RELIEF_MIN_EDGE_PCT=-1.5
PROBABILITY_GATE_RELIEF_MIN_EV_PCT=-4.0

# Build more market-derived and simple-market candidates, but do not publish them directly.
MARKET_DERIVED_CANDIDATES_ENABLED=true
MARKET_DERIVED_MIN_BOOKS=1
MARKET_DERIVED_MIN_SOURCES=1
MARKET_DERIVED_MIN_OBSERVATIONS=1
MARKET_DERIVED_MIN_EDGE_PCT=0.2
MARKET_DERIVED_MIN_DELTA_PROB_PP=-2.0
MARKET_DERIVED_MAX_DISPERSION_PCT=8.0
MARKET_DERIVED_MAX_H2H_ODDS=2.65
MARKET_DERIVED_CONSENSUS_RELIEF_ENABLED=true
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_BOOKS=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_SOURCES=1
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_EDGE_PCT=0.2
MARKET_DERIVED_CONSENSUS_RELIEF_MAX_DISPERSION_PCT=7.0
MARKET_DERIVED_CONSENSUS_RELIEF_MIN_OBSERVATIONS=1
MARKET_DERIVED_CONSENSUS_RELIEF_PROBABILITY_GAP_MAX=0.08
MARKET_DERIVED_CONSENSUS_RELIEF_PROBABILITY_BOOST_PCT=0.65

SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true
SIMPLE_MARKET_MIN_SIGNAL_BOOST_PCT=0.20
SIMPLE_MARKET_TOTALS_MIN_EV_PCT=-4.0
SIMPLE_MARKET_TOTALS_MIN_EDGE_PCT=-1.5
SIMPLE_MARKET_TOTALS_MIN_CONFIDENCE=48
SIMPLE_MARKET_H2H_MIN_EV_PCT=-4.0
SIMPLE_MARKET_H2H_MIN_EDGE_PCT=-1.5
SIMPLE_MARKET_H2H_MIN_CONFIDENCE=48
SIMPLE_MARKET_SPREADS_MIN_EV_PCT=-4.0
SIMPLE_MARKET_SPREADS_MIN_EDGE_PCT=-1.5
SIMPLE_MARKET_SPREADS_MIN_CONFIDENCE=48

# Store more rejected/shadow candidates so future runs have a richer fallback pool.
SHADOW_TRACKING_ENABLED=true
SHADOW_TRACKING_MAX_PER_RUN=20
SHADOW_TRACKING_MIN_PUBLICATION_SCORE=0
SHADOW_TRACKING_MIN_EV_PCT=-4.0
SHADOW_TRACKING_MIN_EDGE_PCT=-1.5
SHADOW_TRACKING_MIN_CONFIDENCE=45
SHADOW_TRACKING_STORE_QUALITY_REJECTIONS=true

# External controlled fallback gate. This remains the only Telegram publisher.
CONTROLLED_FALLBACK_ENABLED=true
CONTROLLED_FALLBACK_SEND_TELEGRAM=true
CONTROLLED_FALLBACK_SEND_NO_PICK_REPORT=true
CONTROLLED_FALLBACK_INCLUDE_LATEST_PICKS=true
CONTROLLED_FALLBACK_INCLUDE_DEBUG_CANDIDATES=true
CONTROLLED_FALLBACK_INCLUDE_STATE_SHADOW=true
CONTROLLED_FALLBACK_MAX_STATE_SHADOW_CANDIDATES=60
CONTROLLED_FALLBACK_REPORT_MAX_EVALUATED=100

CONTROLLED_FALLBACK_ALLOWED_FAMILIES=totals,dnb,teamtotals,teamTotals,btts
CONTROLLED_FALLBACK_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard,post_calibration_probability_guard,post_calibration_edge_guard
CONTROLLED_FALLBACK_GLOBAL_MIN_ODDS=1.50
CONTROLLED_FALLBACK_GLOBAL_MAX_ODDS=3.10
CONTROLLED_FALLBACK_H2H_MAX_ODDS=2.25

CONTROLLED_FALLBACK_DEDUPE_HOURS=72
CONTROLLED_FALLBACK_DEDUPE_STATE_BETS=true
CONTROLLED_FALLBACK_DEDUPE_STATE_PUBLISHED=true
CONTROLLED_FALLBACK_DEDUPE_STATE_SHADOW=false

CONTROLLED_FALLBACK_TIER_A_ALLOWED_FAMILIES=totals,dnb,teamtotals,teamTotals
CONTROLLED_FALLBACK_TIER_A_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_A_MIN_CONFIDENCE=62
CONTROLLED_FALLBACK_TIER_A_MIN_QUALITY=64
CONTROLLED_FALLBACK_TIER_A_MIN_EDGE_PP=2.2
CONTROLLED_FALLBACK_TIER_A_MIN_EV_PCT=3.8
CONTROLLED_FALLBACK_TIER_A_MIN_PUBLICATION_SCORE=22
CONTROLLED_FALLBACK_TIER_A_MAX_ODDS=2.85

CONTROLLED_FALLBACK_TIER_B_ALLOWED_FAMILIES=totals,dnb,teamtotals,teamTotals,btts
CONTROLLED_FALLBACK_TIER_B_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_B_MIN_CONFIDENCE=60
CONTROLLED_FALLBACK_TIER_B_MIN_QUALITY=55
CONTROLLED_FALLBACK_TIER_B_MIN_EDGE_PP=1.2
CONTROLLED_FALLBACK_TIER_B_MIN_EV_PCT=2.5
CONTROLLED_FALLBACK_TIER_B_MIN_PUBLICATION_SCORE=16
CONTROLLED_FALLBACK_TIER_B_MAX_ODDS=2.95

CONTROLLED_FALLBACK_TIER_C_ALLOWED_FAMILIES=totals,teamtotals,teamTotals,dnb,btts
CONTROLLED_FALLBACK_TIER_C_MIN_BOOKS=1
CONTROLLED_FALLBACK_TIER_C_MIN_CONFIDENCE=56
CONTROLLED_FALLBACK_TIER_C_MIN_QUALITY=42
CONTROLLED_FALLBACK_TIER_C_MIN_EDGE_PP=0.8
CONTROLLED_FALLBACK_TIER_C_MIN_EV_PCT=3.5
CONTROLLED_FALLBACK_TIER_C_MIN_PUBLICATION_SCORE=10
CONTROLLED_FALLBACK_TIER_C_MAX_ODDS=2.90
CONTROLLED_FALLBACK_TIER_C_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard,post_calibration_probability_guard,post_calibration_edge_guard

CONTROLLED_FALLBACK_STAKE_PCT=0.65
CONTROLLED_FALLBACK_MIN_STAKE=5
CONTROLLED_FALLBACK_MAX_STAKE_TIER_A=8
CONTROLLED_FALLBACK_MAX_STAKE_TIER_B=6
CONTROLLED_FALLBACK_MAX_STAKE_TIER_C=5
