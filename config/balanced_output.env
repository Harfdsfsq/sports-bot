# Balanced profile v2: tiered controlled fallback.
# Purpose: produce one low-stake forecast when normal quality returns 0, without rescuing negative-value candidates.
PUBLISH_WINDOW_HOURS=24
MIN_KICKOFF_LEAD_MINUTES=20
MAX_PICKS_PER_RUN=1
MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

ODDS_MIN=1.55
ODDS_MAX=2.85
TARGET_ODDS_HARD_MIN=1.55
TARGET_ODDS_HARD_MAX=2.85

BANKROLL_KELLY_ENABLED=false
BANKROLL_FLAT_STAKE_PCT=0.65
BANKROLL_MIN_STAKE_AMOUNT=5
BANKROLL_MAX_STAKE_PCT=1.0
BANKROLL_MAX_OPEN_EXPOSURE_PCT=16

QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_LAST_RESORT_MIN_BOOKS=2
QUALITY_LAST_RESORT_MIN_CONFIDENCE=65
QUALITY_LAST_RESORT_MIN_EV_PCT=3.0
QUALITY_LAST_RESORT_MIN_EDGE_PCT=2.0
MIN_QUALITY_SCORE_PUBLISH=62
QUALITY_HIGH_ODDS_MIN_ODDS=2.85

# Keep primary market-derived generation controlled. Fallback below may still rescue from debug candidates.
MARKET_DERIVED_CANDIDATES_ENABLED=false
SIMPLE_MARKET_FALLBACK_ENABLED=true
PARTIAL_CONTEXT_MARKET_FALLBACK_ENABLED=true

CONTROLLED_FALLBACK_ENABLED=true
CONTROLLED_FALLBACK_SEND_TELEGRAM=true
CONTROLLED_FALLBACK_TIERED_MODE=true
CONTROLLED_FALLBACK_ALLOWED_FAMILIES=totals,dnb,teamTotals
CONTROLLED_FALLBACK_ALLOWED_QUALITY_STOPS=bad_historical_segment_guard,historical_guard,no_bet_quality_score_guard,post_calibration_probability_guard,post_calibration_edge_guard
CONTROLLED_FALLBACK_MIN_ODDS=1.55
CONTROLLED_FALLBACK_MAX_ODDS=2.85
CONTROLLED_FALLBACK_MIN_SOURCES=1

# Tier A/B for 2-book candidates.
CONTROLLED_FALLBACK_TIER_A_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_A_MIN_CONFIDENCE=60
CONTROLLED_FALLBACK_TIER_A_MIN_QUALITY_SCORE=60
CONTROLLED_FALLBACK_TIER_A_MIN_PUBLICATION_SCORE=26
CONTROLLED_FALLBACK_TIER_A_MIN_CANONICAL_EDGE_PP=1.5
CONTROLLED_FALLBACK_TIER_A_MIN_CANONICAL_EV_PCT=3.0

CONTROLLED_FALLBACK_TIER_B_MIN_BOOKS=2
CONTROLLED_FALLBACK_TIER_B_MIN_CONFIDENCE=61
CONTROLLED_FALLBACK_TIER_B_MIN_QUALITY_SCORE=52
CONTROLLED_FALLBACK_TIER_B_MIN_PUBLICATION_SCORE=22
CONTROLLED_FALLBACK_TIER_B_MIN_CANONICAL_EDGE_PP=1.0
CONTROLLED_FALLBACK_TIER_B_MIN_CANONICAL_EV_PCT=2.0
CONTROLLED_FALLBACK_TIER_B_MAX_ODDS=2.35

# Tier C: one-book rescue. Only allowed when no 2-book value candidate exists.
CONTROLLED_FALLBACK_ALLOW_SINGLE_BOOK=true
CONTROLLED_FALLBACK_SINGLE_BOOK_ALLOWED_FAMILIES=totals,teamTotals,dnb
CONTROLLED_FALLBACK_SINGLE_BOOK_ALLOWED_BOOKMAKERS=Bet365,Unibet,Pinnacle,Betfair,Bwin
CONTROLLED_FALLBACK_SINGLE_BOOK_MIN_CONFIDENCE=61
CONTROLLED_FALLBACK_SINGLE_BOOK_MIN_QUALITY_SCORE=52
CONTROLLED_FALLBACK_SINGLE_BOOK_MIN_PUBLICATION_SCORE=30
CONTROLLED_FALLBACK_SINGLE_BOOK_MIN_CANONICAL_EDGE_PP=1.8
CONTROLLED_FALLBACK_SINGLE_BOOK_MIN_CANONICAL_EV_PCT=5.0
CONTROLLED_FALLBACK_SINGLE_BOOK_MAX_ODDS=2.85

CONTROLLED_FALLBACK_STAKE_PCT=0.65
CONTROLLED_FALLBACK_MIN_STAKE=5
CONTROLLED_FALLBACK_MAX_STAKE=5
