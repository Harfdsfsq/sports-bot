# Balanced profile: wider candidate supply + strict final controlled reserve.
PUBLISH_WINDOW_HOURS=24
MIN_KICKOFF_LEAD_MINUTES=20
MAX_PICKS_PER_RUN=1
MIN_BOOKS_PUBLISH=1
MIN_SOURCES_PUBLISH=1
MAX_INTERNAL_CANDIDATES_PER_RUN=60
MAX_CANDIDATES_PER_MATCH_PRE_FILTER=10
RESCUE_DEBUG_CANDIDATE_LIMIT=240

ODDS_MIN=1.40
ODDS_MAX=3.20
TARGET_ODDS_HARD_MIN=1.40
TARGET_ODDS_HARD_MAX=3.20

BANKROLL_KELLY_ENABLED=false
BANKROLL_FLAT_STAKE_PCT=0.65
BANKROLL_MIN_STAKE_AMOUNT=5
BANKROLL_MAX_STAKE_PCT=1.0
BANKROLL_MAX_OPEN_EXPOSURE_PCT=16

RUN_REPORT_ENABLED=false
RUN_REPORT_ONLY_WHEN_NO_PREDICTIONS=true

QUALITY_EMERGENCY_PUBLISH_ENABLED=false
HISTORICAL_SEGMENT_RELIEF_ENABLED=false
QUALITY_LAST_RESORT_MIN_BOOKS=99
QUALITY_LAST_RESORT_MIN_CONFIDENCE=99
QUALITY_LAST_RESORT_MIN_EV_PCT=999
QUALITY_LAST_RESORT_MIN_EDGE_PCT=999
QUALITY_FALLBACK_MIN_BOOKS_STRICT=99
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=99
MIN_QUALITY_SCORE_PUBLISH=62
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_HIGH_ODDS_MIN_ODDS=2.85

# These are intentionally loose only before external reserve.
# Final publication is still blocked by canonical EV/edge.
MIN_EDGE_PCT=-25.0
MIN_EV_PCT=-50.0
MIN_MODEL_CONFIDENCE=0.35
PROBABILITY_GATE_RELIEF_MAX_GAP=0.25
PROBABILITY_GATE_RELIEF_MIN_CONFIDENCE=35
