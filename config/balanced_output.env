CONTROLLED_FALLBACK_MAX_ODDS=2.85
CONTROLLED_FALLBACK_MIN_BOOKS=2
CONTROLLED_FALLBACK_MIN_SOURCES=1
CONTROLLED_FALLBACK_MIN_CONFIDENCE=60
CONTROLLED_FALLBACK_MIN_QUALITY_SCORE=68
CONTROLLED_FALLBACK_MIN_PUBLICATION_SCORE=30
CONTROLLED_FALLBACK_MIN_CANONICAL_EDGE_PP=3.0
CONTROLLED_FALLBACK_MIN_CANONICAL_EV_PCT=5.0
CONTROLLED_FALLBACK_STAKE_PCT=1.0
CONTROLLED_FALLBACK_MIN_STAKE=5
