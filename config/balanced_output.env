# RapidAPI quota/probe layer.
# Uses RAPIDAPI_KEY from GitHub Secrets. Do not hardcode keys in files.
# The probe writes .data/exports/latest-rapidapi-provider-probe.json and .data/provider_quota_state.json.
# It is diagnostics-only until endpoint schemas are verified.
RAPIDAPI_ENDPOINT_DISCOVERY_ENABLED=true
RAPIDAPI_ENDPOINT_DISCOVERY_TIMEOUT_SECONDS=12
RAPIDAPI_DISCOVERY_MAX_CALLS_TOTAL=16
RAPIDAPI_DISCOVERY_FREE_FOOTBALL_MAX_CALLS=6
