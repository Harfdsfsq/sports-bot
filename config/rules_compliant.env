# Strict RULES.txt runtime overlay
# Use this with the production workflow to make the bot act as a cumulative
# value-candidate lifecycle system instead of a one-shot parser.

RULES_COMPLIANT_PIPELINE_ENABLED=true

# Daily inventory must be a decision-focused top-300.
DAILY_INVENTORY_MAX_MATCHES=300
DAY_INVENTORY_MAX_MATCHES=300
DAY_INVENTORY_RUN_MATCH_LIMIT=300
ANALYSIS_MATCH_CAP_PER_RUN=300
MAX_MATCHES_FOR_ODDS_FETCH=300

# Required time windows: 0-4, 4-8, 8-12, 12-16, 16-20, 20-24, 24h+.
DAY_INVENTORY_NEAR_WINDOW_HOURS=24
HARIZON_DATA_COLLECTION_WINDOW_HOURS=24
PUBLISH_WINDOW_HOURS=24
CRON_EXPECTED_INTERVAL_MINUTES=120
LINE_MOVEMENT_CRON_INTERVAL_MINUTES=120
LINE_MOVEMENT_CRON_ANCHOR_MINUTE=0
LINE_MOVEMENT_CRON_TIMEZONE=Europe/Moscow
LINE_MOVEMENT_USE_SCHEDULED_CRON=true
LINE_MOVEMENT_MIN_LEAD_MINUTES=15
LINE_MOVEMENT_MIN_RECHECK_MINUTES=60
LINE_MOVEMENT_MAX_ADVERSE_DRIFT_PCT=3.0

# Publication coverage from the rules:
# B-tier: 1 line/odds source, 2 bookmakers, 1 context, 1 confirmation.
# A-tier: 2 lines/odds sources, 2 bookmakers, 2 contexts, 2 confirmations.
PUBLISH_ALLOW_B_TIER=true
PUBLISH_MIN_BOOKS=2
MIN_BOOKS_PUBLISH=2
PUBLISH_MIN_ODDS_SOURCES=1
MIN_SOURCES_PUBLISH=1
PUBLISH_MIN_CONTEXT_SOURCES=1
MIN_CONTEXT_SOURCES_PUBLISH=1
PUBLISH_TIER_A_MIN_BOOKS=2
PUBLISH_TIER_A_MIN_ODDS_SOURCES=2
PUBLISH_TIER_A_MIN_CONTEXT_SOURCES=2
PUBLISH_TIER_B_MIN_BOOKS=2
PUBLISH_TIER_B_MIN_ODDS_SOURCES=1
PUBLISH_TIER_B_MIN_CONTEXT_SOURCES=1

# Do not publish newly found candidates if another regular run can recheck them
# before kickoff. Publish only after movement/value survives the recheck, or when
# no useful next run remains before kickoff.
LINE_MOVEMENT_MIN_CURRENT_EV_PCT=0.0
LINE_MOVEMENT_MIN_CURRENT_EDGE_PCT=0.0
FINAL_ENRICHMENT_ONLY_FOR_VALUE_CANDIDATES=true
FINAL_ENRICHMENT_FALLBACK_NEAREST_MATCH_LIMIT=0
RULES_MAX_PROVIDER_DISPERSION_PCT=8.5

# Keep quality meaningful. Do not enable emergency/last-resort publication that
# bypasses the rules contract.
FORCE_PUBLISH_WHEN_EMPTY_ENABLED=false
QUALITY_EMERGENCY_PUBLISH_ENABLED=false
QUALITY_LAST_RESORT_PUBLISH_ENABLED=false
REPUBLISH_SEEN_CANDIDATES_WHEN_EMPTY=false
ALLOW_LOW_TIER=false

# Reports for verification.
RULES_COMPLIANCE_AUDIT_PATH=.data/exports/latest-rules-compliance.json
COVERAGE_PLANNER_EXPORT_PATH=.data/exports/latest-coverage-planner.json
