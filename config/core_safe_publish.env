# Core publish profile
# Apply these variables to your local .env or GitHub Actions env.
# Goal: prefer core totals + safer side markets, reduce noisy/high-odds publications.

PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=2

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

MIN_EDGE_PCT=3.0
MIN_EV_PCT=2.0
MIN_MODEL_CONFIDENCE=0.60
ODDS_MIN=1.70
ODDS_MAX=2.80

# Quality layer
QUALITY_LAYER_ENABLED=true
MIN_QUALITY_SCORE_PUBLISH=68.0
NO_BET_QUALITY_SCORE_ENABLED=true
QUALITY_FALLBACK_MIN_BOOKS_STRICT=2

# Totals are the preferred market family
QUALITY_TOTALS_FALLBACK_ENABLED=true
QUALITY_TOTALS_FALLBACK_MIN_BOOKS=2
QUALITY_TOTALS_FALLBACK_MIN_CONFIDENCE=62.0
QUALITY_TOTALS_FALLBACK_MIN_EV_PCT=2.0
QUALITY_TOTALS_FALLBACK_MIN_EDGE_PCT=3.0
QUALITY_TOTALS_FALLBACK_OVER_MIN_XG_HEADROOM=0.45
QUALITY_TOTALS_FALLBACK_UNDER_MIN_XG_HEADROOM=0.35

# Tighten emergency/last-resort publication paths
QUALITY_EMERGENCY_MIN_CONFIDENCE=62.0
QUALITY_EMERGENCY_MIN_EV_PCT=2.0
QUALITY_EMERGENCY_MIN_EDGE_PCT=3.0
QUALITY_EMERGENCY_MIN_BOOKS=2
QUALITY_LAST_RESORT_MIN_CONFIDENCE=62.0
QUALITY_LAST_RESORT_MIN_EV_PCT=2.0
QUALITY_LAST_RESORT_MIN_EDGE_PCT=3.0
QUALITY_LAST_RESORT_MIN_BOOKS=2
HISTORICAL_SEGMENT_RELIEF_MIN_CONFIDENCE=64.0
HISTORICAL_SEGMENT_RELIEF_MIN_EV_PCT=2.0
HISTORICAL_SEGMENT_RELIEF_MIN_EDGE_PCT=3.0
HISTORICAL_SEGMENT_RELIEF_MIN_BOOKS=2
HISTORICAL_SEGMENT_RELIEF_MIN_PUBLICATION_SCORE=18.0

# Single-source/high-odds relief should be conservative
CORE_SINGLE_BOOK_RELIEF_ENABLED=false
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_PP=12.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_QUALITY=82.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_CONFIDENCE=72.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_EV_PCT=16.0
QUALITY_HIGH_ODDS_MIN_ODDS=2.60

# Odds sanity audit (used by scripts / workflows in this overlay)
ODDS_SANITY_MAX_IMPLIED_GAP_PP=3.0
ODDS_SANITY_MAX_ODDS_TO_FAIR_RATIO=1.20
ODDS_SANITY_FAIL_ON_PUBLISHED=true
