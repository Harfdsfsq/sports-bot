# Overlay profile: keep as much decision trail as possible for debugging and future improvements.
RUN_LOGS_DIR=.logs/runs
DEBUG_PATH=.logs/debug-last-run.json
STORAGE_EXPORT_DIR=.data/exports

RUN_REPORT_ENABLED=true
RUN_REPORT_ONLY_WHEN_NO_PREDICTIONS=false
RUN_REPORT_TOP_REASONS=12

DAILY_REPORT_ENABLED=true
DAILY_REPORT_SEND_TELEGRAM=true
DAILY_REPORT_RESEND_ON_CHANGE=true
NIGHTLY_REVIEW_REPORT_ONLY_ENABLED=false
NIGHTLY_REVIEW_STORE_ADJUSTMENTS_ENABLED=true

ENABLE_PROVIDER_DIAGNOSTICS=true
SHADOW_TRACKING_ENABLED=true
SHADOW_TRACKING_MAX_PER_RUN=8
SHADOW_TRACKING_MIN_PUBLICATION_SCORE=8.0
SHADOW_TRACKING_MIN_EV_PCT=0.3
SHADOW_TRACKING_MIN_EDGE_PCT=0.6
SHADOW_TRACKING_MIN_CONFIDENCE=46.0
SHADOW_TRACKING_STORE_QUALITY_REJECTIONS=true

DETAILED_TELEGRAM_WRITEUP=true
TELEGRAM_WRITEUP_MAX_POINTS=6
TELEGRAM_WRITEUP_MIN_RECENT_SAMPLE=2
TELEGRAM_WRITEUP_MIN_SPLIT_SAMPLE=2

QUALITY_LAYER_ENABLED=true
CALIBRATION_ENABLED=true

# Keep odds/line sanity visible in exports.
PROBABILITY_GATE_RELIEF_MAX_GAP=0.06
