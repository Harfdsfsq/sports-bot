{
  "runs_per_day_assumption": 12,
  "policy_version": "2026-05-05.v1",
  "notes": [
    "Limits are conservative per-run budgets for the normal run. Context/news/weather providers must not count as price confirmation.",
    "Daily/static sources are cached and should be fetched once per day or less.",
    "Removed sources are intentionally absent: oddspapi, api-football/api-sports, bookies api."
  ],
  "providers": {
    "odds_api_io_account1": {"role": "odds", "free_quota_basis": "account/free plan; keep existing provider cap", "max_requests_per_run": 140, "priority": "core"},
    "odds_api_io_account2": {"role": "odds", "free_quota_basis": "second account/free plan; keep existing provider cap", "max_requests_per_run": 140, "priority": "core"},
    "bzzoiro_events": {"role": "context", "free_quota_basis": "unstable endpoint; lightweight only", "max_requests_per_run": 1, "timeout_seconds": 18, "page_size": 3, "critical": false},
    "bzzoiro_predictions": {"role": "context", "free_quota_basis": "working context endpoint", "max_requests_per_run": 1, "timeout_seconds": 18, "page_size": 5, "critical": false},
    "sstats": {"role": "context", "free_quota_basis": "daily budget protected", "max_requests_per_run": 12, "critical": false},
    "football_data": {"role": "context", "free_quota_basis": "10 req/min style free access; cache standings/results", "max_requests_per_run": 4, "critical": false},
    "thesportsdb": {"role": "mapping_context", "free_quota_basis": "free key; cache catalogue lookups", "max_requests_per_run": 4, "critical": false},
    "allsportsapi": {"role": "context", "free_quota_basis": "free plan has narrow league access", "max_requests_per_run": 1, "critical": false},
    "futrixmetrics": {"role": "context", "free_quota_basis": "ratings/context only", "max_requests_per_run": 6, "critical": false},
    "highlightly": {"role": "context", "free_quota_basis": "conservative free/RapidAPI use", "max_requests_per_run": 4, "critical": false},
    "free_football_rapidapi": {"role": "context", "free_quota_basis": "RapidAPI fallback only", "max_requests_per_run": 2, "critical": false},
    "sportlogic_games_broad": {"role": "fixtures_context", "free_quota_basis": "500/day class; broad fallback, not mass polling", "max_requests_per_run": 8, "critical": false},
    "sportlogic_leagues": {"role": "mapping_context", "free_quota_basis": "catalogue cache", "max_requests_per_run": 1, "critical": false},
    "weatherapi": {"role": "weather", "free_quota_basis": "large monthly free quota; cache by venue/hour", "max_requests_per_run": 40, "critical": false},
    "openweathermap": {"role": "weather", "free_quota_basis": "daily free cap; fallback after WeatherAPI", "max_requests_per_run": 20, "critical": false},
    "open_meteo": {"role": "weather", "free_quota_basis": "no-key fallback; cache by venue/hour", "max_requests_per_run": 60, "critical": false},
    "meteostat_rapidapi": {"role": "weather_history", "free_quota_basis": "RapidAPI fallback; use sparingly", "max_requests_per_run": 2, "critical": false},
    "newsapi": {"role": "news", "free_quota_basis": "small/dev free quota; fallback only", "max_requests_per_run": 2, "critical": false},
    "currents": {"role": "news", "free_quota_basis": "small free quota; cache queries", "max_requests_per_run": 2, "critical": false},
    "gnews": {"role": "news", "free_quota_basis": "small free quota; cache queries", "max_requests_per_run": 2, "critical": false},
    "newsdata": {"role": "news", "free_quota_basis": "news fallback", "max_requests_per_run": 2, "critical": false},
    "guardian": {"role": "news", "free_quota_basis": "500/day class; conservative fallback", "max_requests_per_run": 3, "critical": false},
    "clubelo_today": {"role": "rating_cache", "free_quota_basis": "no-key CSV; daily cache", "max_requests_per_day": 1, "critical": false},
    "football_data_co_uk_epl": {"role": "historical_csv_cache", "free_quota_basis": "no-key CSV; daily cache", "max_requests_per_day": 1, "critical": false},
    "wikidata_entity": {"role": "mapping_cache", "free_quota_basis": "fair use; cache aliases", "max_requests_per_day": 4, "critical": false},
    "wikidata_sparql": {"role": "mapping_cache", "free_quota_basis": "fair use; cache sparql results", "max_requests_per_day": 2, "critical": false}
  }
}
