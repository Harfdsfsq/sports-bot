# Main-channel publication is now done by scripts/publish_clean_pick.py
# after the bot finishes one dry-run snapshot.

# Bot run profile
PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=1

# Keep the run narrower and cleaner
MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

# Strategy focus
MAIN_CLEAN_ALLOWED_FAMILIES=totals,dnb
MAIN_CLEAN_MIN_QUALITY=70
MAIN_CLEAN_MIN_SIGNAL_SCORE=65
MAIN_CLEAN_MIN_CONFIDENCE=64
MAIN_CLEAN_MIN_EDGE_PCT=3.5
MAIN_CLEAN_MAX_ODDS=2.35
MAIN_CLEAN_REQUIRE_BOOKS=2

# Integrity guard
MAIN_CLEAN_MAX_IMPLIED_MISMATCH=0.02
MAIN_CLEAN_MAX_ADJUSTED_MISMATCH=0.02
MAIN_CLEAN_MAX_FINAL_MISMATCH=0.02

# Risk profile
MAIN_CLEAN_REJECT_SINGLE_SOURCE=true
MAIN_CLEAN_REJECT_FALLBACK=true
MAIN_CLEAN_REJECT_HIGH_RISK_LABELS=true

# Optional: stricter totals-only mode
# MAIN_CLEAN_ALLOWED_FAMILIES=totals
