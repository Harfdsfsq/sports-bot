DAY_SHORTLIST_MAX_ITEMS=40
DAY_SHORTLIST_KEEP_PER_MATCH=3
DAY_SHORTLIST_CARRYOVER_ENABLED=true
DAY_SHORTLIST_CARRYOVER_INCLUDE_SHADOW=false
