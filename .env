APP_TIMEZONE=Europe/Moscow
PUBLISH_DRY_RUN=false

MATCH_BOOTSTRAP_PROVIDER=odds_api_io
PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30

ENABLE_CONTEXT_STAGING=true
CONTEXT_ENRICHMENT_REQUIRES_OFFERS=false
CONTEXT_ENRICHMENT_MATCH_LIMIT=220
PREMIUM_CONTEXT_SHORTLIST_LIMIT=24
PREMIUM_NEWS_SHORTLIST_LIMIT=4

BZZOIRO_CONTEXT_MATCH_LIMIT=220
ESPN_CONTEXT_MATCH_LIMIT=160
THESPORTSDB_CONTEXT_MATCH_LIMIT=220
FOOTBALL_DATA_CONTEXT_MATCH_LIMIT=220
OPENFOOTBALL_CONTEXT_MATCH_LIMIT=240
OPENLIGADB_CONTEXT_MATCH_LIMIT=140
API_FOOTBALL_CONTEXT_MATCH_LIMIT=24
API_FOOTBALL_PREDICTIONS_LIMIT=14
NEWSAPI_CONTEXT_MATCH_LIMIT=10
GNEWS_CONTEXT_MATCH_LIMIT=8

ODDSPAPI_MATCH_LIMIT=10
ODDSPAPI_TOURNAMENT_LIMIT=4
ALLSPORTSAPI_MATCH_LIMIT=14

MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=2
NON_CORE_LEAGUE_MIN_BOOKS=2
NON_CORE_LEAGUE_REQUIRE_CORE_CONTEXT=true

DAILY_COVERAGE_CACHE_ENABLED=true
DAILY_COVERAGE_CACHE_PATH=.data/provider_cache/daily-coverage
DAILY_COVERAGE_MATCH_TTL_MINUTES=120
DAILY_COVERAGE_OFFERS_TTL_MINUTES=75
DAILY_COVERAGE_BACKUP_OFFERS_TTL_MINUTES=240
DAILY_COVERAGE_CONTEXT_TTL_MINUTES=360
DAILY_COVERAGE_PREMIUM_CONTEXT_TTL_MINUTES=300
DAILY_COVERAGE_NEWS_CONTEXT_TTL_MINUTES=120
DAILY_COVERAGE_EMPTY_MATCHES_TTL_MINUTES=60
DAILY_COVERAGE_EMPTY_OFFERS_TTL_MINUTES=90
DAILY_COVERAGE_EMPTY_CONTEXT_TTL_MINUTES=180

ODDS_API_IO_KEY=
ODDSPAPI_API_KEY=
ALLSPORTSAPI_API_KEY=
FUTRIXMETRICS_API_KEY=
SSTATS_API_KEY=
BZZOIRO_API_KEY=
API_FOOTBALL_KEY=
FOOTBALL_DATA_API_KEY=
THESPORTSDB_API_KEY=
NEWSAPI_KEY=
GNEWS_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

