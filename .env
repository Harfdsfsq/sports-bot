# Non-secret local parity file for HARIZON.
# Put real API keys into your shell, GitHub Secrets, or a private local .env override.

TZ=Europe/Moscow
APP_TIMEZONE=Europe/Moscow
PUBLISH_DRY_RUN=false
PREDICTION_PUBLICATION_ENABLED=true
RUN_REPORT_ENABLED=true
RUN_REPORT_ALWAYS=true
DAY_PREDICTIONS_REPORT_ENABLED=true

TARGET_BOOKMAKERS=Bet365,Unibet
CONSENSUS_BOOKMAKERS=Bet365,Unibet
SHARP_BOOKMAKERS=Bet365,Unibet
MIN_BOOKS_PUBLISH=2
MIN_SOURCES_PUBLISH=1

ENABLE_CONTEXT_STAGING=true
CONTEXT_ENRICHMENT_REQUIRES_OFFERS=false
CONTEXT_ENRICHMENT_MATCH_LIMIT=220
PREMIUM_CONTEXT_SHORTLIST_LIMIT=24
PREMIUM_NEWS_SHORTLIST_LIMIT=4

DAILY_COVERAGE_CACHE_ENABLED=true
DAILY_COVERAGE_CACHE_PATH=.data/provider_cache/daily-coverage
DAY_SHORTLIST_ENABLED=true
DAY_SHORTLIST_CARRYOVER_ENABLED=true

ODDSPAPI_ENABLED=false
ALLSPORTSAPI_ENABLED=false
API_FOOTBALL_ENABLED=false
ENABLE_BZZOIRO_CONTEXT=true
ENABLE_ESPN_CONTEXT=true
ENABLE_THESPORTSDB_CONTEXT=false
ENABLE_FOOTBALL_DATA_CONTEXT=false
ENABLE_OPENLIGADB_CONTEXT=true
ENABLE_OPENFOOTBALL_CONTEXT=true
FUTRIXMETRICS_ENABLED=false
ENABLE_NEWSAPI_CONTEXT=false
ENABLE_GNEWS_CONTEXT=false

MATCH_BOOTSTRAP_PROVIDER=odds_api_io
PUBLISH_WINDOW_HOURS=12
MIN_KICKOFF_LEAD_MINUTES=30
MAX_PICKS_PER_RUN=2

POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_PP=10.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_QUALITY=80.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_CONFIDENCE=70.0
POSTFILTER_SINGLE_SOURCE_HEAVY_SHRINK_MIN_EV_PCT=14.0
