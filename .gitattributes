# Cumulative runtime state and day-inventory JSON are merged semantically during
# the run-bot rebase.
.data/*.json merge=harizon-runtime-json
.data/day_inventory/*.json merge=harizon-runtime-json
.data/cache/day_inventory/*.json merge=harizon-runtime-json
.data/line_history/*.json merge=harizon-runtime-json

# latest-* exports are snapshots, not cumulative state. Keep the commit being
# replayed instead of combining two runs or leaving literal conflict markers.
.data/exports/latest-*.json merge=harizon-runtime-latest
.data/exports/latest-*.txt merge=harizon-runtime-latest
.data/exports/latest-*.csv merge=harizon-runtime-latest
